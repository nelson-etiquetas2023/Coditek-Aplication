<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xam"
             xmlns:quickgrid="http://schemas.microsoft.com/dotnet/2022/maui/controls/quickgrid"
             x:Class="CodixLabels.ProductsPage"
             Title="Productos"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nuevo" Order="Primary"
                     Clicked="OnNewClicked"
                     IconImage="plus.png" />
        <ToolbarItem Text="Buscar" Order="Secondary"
                     Clicked="OnSearchClicked"
                     IconImage="search.png" />
    </ToolbarItem>

    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label Text="Productos"
                   FontAttributes="Bold"
                   FontSize="20"
                   TextColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Start"
                   Margin="0, 0, 0, 10" />

            <Entry x:Name="SearchEntry"
                   Placeholder="Buscar por nombre, código o descripción..."
                   TextChanged="OnSearchChanged"
                   Margin="0, 0, 0, 10"
                   FontSize="14" />

            <quickgrid:QuickGrid x:Name="ProductsGrid"
                                 ItemsSource="{Binding Products}"
                                 SelectionMode="None"
                                 VerticalScrollBarVisibility="Default"
                                 RowHeight="40">
                <quickgrid:QuickGrid.Columns>
                    <quickgrid:PropertyColumn Property="Id" Title="Id" />
                    <quickgrid:PropertyColumn Property="Name" Title="Nombre" />
                    <quickgrid:PropertyColumn Property="Code" Título="Código" />
                    <quickgrid:PropertyColumn Property="Price" Title="Precio" />
                </quickgrid:QuickGrid.Columns>

                <quickgrid:QuickGrid.Footer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Picker x:Name="ItemsPerPagePicker"
                                SelectedIndexChanged="OnItemsPerPageChanged"
                                VerticalOptions="Center" />
                        <Button Text="Eliminar Seleccionados"
                                Clicked="OnDeleteSelected"
                                Grid.Column="1"
                                HorizontalOptions="End"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </quickgrid:QuickGrid.Footer>
            </quickgrid:QuickGrid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>