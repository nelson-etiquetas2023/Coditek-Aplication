<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xam"
             xmlns:quickgrid="http://schemas.microsoft.com/dotnet/2022/maui/controls/quickgrid"
             x:Class="CodixLabels.UsersPage"
             Title="Usuarios"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nuevo" Order="Primary"
                     Clicked="OnNewClicked"
                     IconImage="plus.png" />
        <ToolbarItem Text="Buscar" Order="Secondary"
                     Clicked="OnSearchClicked"
                     IconImage="search.png" />
    </ToolbarItem>

    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label Text="Usuarios"
                   FontAttributes="Bold"
                   FontSize="20"
                   TextColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Start"
                   Margin="0, 0, 0, 10" />

            <Entry x:Name="SearchEntry"
                   Placeholder="Buscar por nombre, email o rol..."
                   TextChanged="OnSearchChanged"
                   Margin="0, 0, 0, 10"
                   FontSize="14" />

            <QuickGrid x:Name="UsersGrid"
                       ItemsSource="{Binding Users}"
                       SelectionMode="None"
                       VerticalScrollBarVisibility="Default"
                       RowHeight="45">
                <QuickGrid.Columns>
                    <PropertyColumn Property="Id" Title="Id" />
                    <PropertyColumn Property="UserName" Título="Usuario" />
                    <PropertyColumn Property="Email" Título="Email" />
                    <PropertyColumn Property="Nickname" Título="Nickname" />
                    <QuickGridTemplateColumn Header="Roles">
                        <Label Text="{Binding Roles, StringFormat='{}{0}'}" />
                    </QuickGridTemplateColumn>
                    <QuickGridTemplateColumn Header="Acciones">
                        <Button Text="Editar"
                                Clicked="OnEditClicked"
                                Classes="btn-primary"
                                Margin="2" />
                        <Button Text="Eliminar"
                                Clicked="OnDeleteClicked"
                                Classes="btn-danger"
                                Margin="2" />
                    </QuickGridTemplateColumn>
                </QuickGrid.Columns>

                <QuickGrid.Footer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Picker x:Name="ItemsPerPagePickerUsers"
                                SelectedIndexChanged="OnItemsPerPageChangedUsers"
                                VerticalOptions="Center" />
                        <Button Text="Eliminar Seleccionados"
                                Clicked="OnDeleteSelectedUsers"
                                Grid.Column="1"
                                HorizontalOptions="End" />
                    </Grid>
                </QuickGrid.Footer>
            </QuickGrid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>