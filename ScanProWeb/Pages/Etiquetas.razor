@page "/etiquetas"
@using BlazorBootstrap
@using Microsoft.AspNetCore.Components.Forms
@inject ApiLabelService Api
@inject IJSRuntime JS
@inject ToastService ToastSvc

<PageTitle>Etiquetas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><Icon Name="IconName.UpcScan" Size="IconSize.x2" /> Etiquetas</h2>
    <button class="btn btn-primary" type="button" @onclick="OpenNew" disabled="@isBusy">
        <Icon Name="IconName.PlusLg" /> Nueva etiqueta
    </button>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @loadError
        <button type="button" class="btn-close" @onclick="() => loadError = string.Empty"></button>
    </div>
}

@if (loading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Cargando etiquetas...</span>
    </div>
}
else
{
    <div class="d-flex gap-3 etiquetas-layout">
        <!-- 30%: búsqueda + grid -->
        <div class="etiquetas-grid">
            <div class="card h-100">
                <div class="card-body p-2 d-flex flex-column">
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text"><Icon Name="IconName.Search" /></span>
                        <input class="form-control" placeholder="Buscar por código o descripción..." @bind="searchText" @bind:event="oninput" />
                    </div>
                    <div class="small text-muted mb-2">
                        <strong>Total:</strong> @labels.Count &nbsp;|&nbsp; <strong>Mostrados:</strong> @FilteredLabels.Count()
                    </div>
                    <div class="table-responsive etiquetas-scroll">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:84px">Código</th>
                                    <th>Descripción</th>
                                    <th style="width:90px">Rollo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredLabels.Any())
                                {
                                    <tr><td colspan="3" class="text-muted text-center py-3">Sin resultados</td></tr>
                                }
                                else
                                {
                                    @foreach (var l in FilteredLabels)
                                    {
                                        var isSelected = selected?.Id == l.Id;
                                        <tr class="@(isSelected ? "table-primary" : "")" style="cursor:pointer" @onclick="() => SelectLabel(l)">
                                            <td class="font-monospace small">@l.Codigo</td>
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width:200px" title="@l.Descripcion">@l.Descripcion</div>
                                            </td>
                                            <td>@l.CantidadPorRollo</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 70%: detalle + preview -->
        <div class="etiquetas-detail">
            <div class="card h-100">
                @if (selected is null)
                {
                    <div class="card-body d-flex align-items-center justify-content-center text-muted">
                        <div class="text-center">
                            <Icon Name="IconName.UpcScan" Size="IconSize.x4" />
                            <div class="mt-2">Selecciona una etiqueta o crea una nueva.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                        <div>
                            <strong>@selected.Descripcion</strong>
                            <span class="text-muted small ms-2 font-monospace">@selected.Codigo</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => OpenEdit(selected)" disabled="@isBusy"><Icon Name="IconName.Pencil" /> Editar</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => ConfirmDelete(selected)" disabled="@isBusy"><Icon Name="IconName.Trash" /> Borrar</button>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <ul class="nav nav-tabs mb-2">
                            <li class="nav-item"><button class="nav-link @(detailTab == "detalle" ? "active" : "")" type="button" @onclick='() => detailTab = "detalle"'>Detalle</button></li>
                            <li class="nav-item"><button class="nav-link @(detailTab == "preview" ? "active" : "")" type="button" @onclick='() => { detailTab = "preview"; _ = RenderPreviewAsync(); }'>Vista previa / ZPL</button></li>
                        </ul>

                        @if (detailTab == "detalle")
                        {
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-0">Código</label>
                                    <div class="font-monospace fw-semibold">@selected.Codigo</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-0">Ancho (in)</label>
                                    <div>@((selected.WidthMm / 25.4m).ToString("0.##")) in</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-0">Largo (in)</label>
                                    <div>@((selected.LengthMm / 25.4m).ToString("0.##")) in</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-0">Cantidad por rollo</label>
                                    <div>@selected.CantidadPorRollo</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small text-muted mb-0">Descripción</label>
                                    <div>@(string.IsNullOrWhiteSpace(selected.Descripcion) ? "—" : selected.Descripcion)</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small text-muted mb-0">Código ZPL</label>
                                    <pre class="bg-light border rounded p-2 small mb-0" style="max-height:220px; overflow:auto; white-space:pre-wrap;">@selected.CodigoZpl</pre>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-lg-5">
                                    <label class="form-label small fw-semibold">Código ZPL</label>
                                    <textarea class="form-control font-monospace small" rows="14" @bind="selected.CodigoZpl"></textarea>
                                    <div class="mt-2 d-flex gap-2 align-items-center flex-wrap">
                                        <button class="btn btn-sm btn-primary" type="button" @onclick="RenderPreviewAsync" disabled="@previewLoading">
                                            @if (previewLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            <Icon Name="IconName.Eye" /> Previsualizar
                                        </button>
                                        <span class="small text-muted">@((selected.WidthMm / 25.4m).ToString("0.##")) × @((selected.LengthMm / 25.4m).ToString("0.##")) in</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(previewError))
                                    {
                                        <div class="alert alert-warning small mt-2 mb-0 py-1">@previewError</div>
                                    }
                                </div>
                                <div class="col-lg-7">
                                    <label class="form-label small fw-semibold">Vista previa (Labelary)</label>
                                    <div class="border rounded bg-white d-flex align-items-center justify-content-center p-2" style="min-height:280px;">
                                        @if (previewLoading)
                                        {
                                            <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Renderizando...</div>
                                        }
                                        else if (!string.IsNullOrEmpty(previewDataUrl))
                                        {
                                            <img src="@previewDataUrl" alt="Vista previa etiqueta" style="max-width:100%; max-height:360px; object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <div class="text-muted small text-center">Haz clic en <strong>Previsualizar</strong> para renderizar el ZPL.<br /><span class="text-secondary">Requiere API disponible (proxy a Labelary).</span></div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<Modal @ref="editModal">
    <HeaderTemplate><Icon Name="IconName.UpcScan" Size="IconSize.x3" /><strong> @(editingId == 0 ? "Nueva etiqueta" : "Editar etiqueta")</strong></HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="@editModel" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-12">
                    <label class="form-label">ID Código</label>
                    <input class="form-control font-monospace" type="text" value="@editModel.Codigo" placeholder="ETI-0000" disabled />
                </div>
                <div class="col-12">
                    <label class="form-label">Descripción de la etiqueta *</label>
                    <InputText class="form-control" @bind-Value="editModel.Descripcion" placeholder="Ej. Etiqueta para productos de 2x1 pulgadas" />
                    <ValidationMessage For="() => editModel.Descripcion" />
                </div>
                @if (editingId != 0)
                {
                    <div class="col-12">
                        <label class="form-label">Cantidad por rollo</label>
                        <InputNumber class="form-control" @bind-Value="editModel.CantidadPorRollo" />
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label">Ancho (in) *</label>
                    <input class="form-control" type="text" inputmode="decimal" placeholder="Ej. 1.2" @bind="widthText" @bind:event="oninput" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Largo (in) *</label>
                    <input class="form-control" type="text" inputmode="decimal" placeholder="Ej. 0.7" @bind="lengthText" @bind:event="oninput" />
                </div>
                <div class="col-12">
                    <label class="form-label">Código ZPL *</label>
                    <InputTextArea class="form-control font-monospace" rows="10" @bind-Value="editModel.CodigoZpl" />
                    <div class="form-text">Debe iniciar con <code>^XA</code> y terminar con <code>^XZ</code>.</div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-secondary" @onclick="CloseEdit" disabled="@isBusy"><Icon Name="IconName.XCircle" /> Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@isBusy">
                    @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <Icon Name="IconName.FloppyFill" /> Guardar
                </button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

<style>
    .etiquetas-layout { min-height: 520px; }
    .etiquetas-grid { flex: 0 0 calc(30% - 8px); min-width: 260px; }
    .etiquetas-detail { flex: 0 0 calc(70% - 8px); min-width: 320px; }
    .etiquetas-scroll { max-height: 420px; overflow-y: auto; }
</style>

@code {
    private List<ApiLabelService.LabelTemplateDto> labels = [];
    private ApiLabelService.LabelTemplateDto? selected;
    private string searchText = "";
    private bool loading = true;
    private bool isBusy;
    private string loadError = "";
    private string detailTab = "detalle";

    private Modal? editModal;
    private ApiLabelService.LabelTemplateDto editModel = new();
    private int editingId;
    private string widthText = "2";
    private string lengthText = "1";

    private bool previewLoading;
    private string? previewDataUrl;
    private string previewError = "";

    private IEnumerable<ApiLabelService.LabelTemplateDto> FilteredLabels
    {
        get
        {
            var q = (searchText ?? "").Trim();
            if (string.IsNullOrEmpty(q)) return labels;
            return labels.Where(l =>
                l.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (l.Codigo ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (l.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync(int? selectId = null)
    {
        loading = true;
        loadError = "";
        try
        {
            labels = await Api.GetAllAsync();
            if (selectId.HasValue)
                selected = labels.FirstOrDefault(l => l.Id == selectId.Value) ?? labels.FirstOrDefault();
            else if (selected is not null)
                selected = labels.FirstOrDefault(l => l.Id == selected.Id) ?? labels.FirstOrDefault();
            else
                selected = labels.FirstOrDefault();
            previewDataUrl = null;
            previewError = "";
        }
        catch (Exception ex) { loadError = $"Error al cargar etiquetas: {ex.Message}"; }
        finally { loading = false; }
    }

    private void SelectLabel(ApiLabelService.LabelTemplateDto l)
    {
        selected = l;
        detailTab = "detalle";
        previewDataUrl = null;
        previewError = "";
    }

    private async Task OpenNew()
    {
        editingId = 0;
        editModel = new ApiLabelService.LabelTemplateDto { Dpmm = 8, WidthMm = 0m, LengthMm = 0m, CantidadPorRollo = 1000, Codigo = "", Descripcion = "", CodigoZpl = "" };
        widthText = "";
        lengthText = "";
        if (editModal is not null) await editModal.ShowAsync();
    }

    private async Task OpenEdit(ApiLabelService.LabelTemplateDto l)
    {
        editingId = l.Id;
        editModel = new ApiLabelService.LabelTemplateDto
        {
            Id = l.Id, Codigo = l.Codigo, Descripcion = l.Descripcion,
            WidthMm = l.WidthMm, LengthMm = l.LengthMm,
            CantidadPorRollo = l.CantidadPorRollo, CodigoZpl = l.CodigoZpl, Dpmm = l.Dpmm
        };
        widthText = Math.Round(l.WidthMm / 25.4m, 4).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        lengthText = Math.Round(l.LengthMm / 25.4m, 4).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        if (editModal is not null) await editModal.ShowAsync();
    }

    private async Task CloseEdit() { if (editModal is not null) await editModal.HideAsync(); }

    private static bool TryParseInches(string? text, out decimal value)
    {
        var normalized = (text ?? "").Trim().Replace(',', '.');
        return decimal.TryParse(normalized, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out value);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editModel.Descripcion)) { ToastSvc.Notify(new(ToastType.Danger, "La descripción de la etiqueta es obligatoria.")); return; }
        if (!TryParseInches(widthText, out var wIn) || !TryParseInches(lengthText, out var lIn))
        {
            ToastSvc.Notify(new(ToastType.Danger, "Ancho y largo deben ser números en pulgadas, ej. 1.2 o 0.7."));
            return;
        }
        editModel.WidthMm = Math.Round(wIn * 25.4m, 2);
        editModel.LengthMm = Math.Round(lIn * 25.4m, 2);
        if (editModel.WidthMm <= 0 || editModel.LengthMm <= 0) { ToastSvc.Notify(new(ToastType.Danger, "Ancho y largo deben ser mayores a 0.")); return; }
        if (string.IsNullOrWhiteSpace(editModel.CodigoZpl)) { ToastSvc.Notify(new(ToastType.Danger, "El código ZPL es obligatorio.")); return; }

        isBusy = true;
        try
        {
            var res = editingId == 0
                ? await Api.CreateAsync(editModel)
                : await Api.UpdateAsync(editingId, editModel);

            if (!res.Success)
            {
                ToastSvc.Notify(new(ToastType.Danger, res.Error ?? "No se pudo guardar."));
                return;
            }

            await CloseEdit();
            await LoadAsync(res.Data?.Id ?? editingId);
            ToastSvc.Notify(new(ToastType.Success, "Etiqueta guardada."));
        }
        finally { isBusy = false; }
    }

    private async Task ConfirmDelete(ApiLabelService.LabelTemplateDto l)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la etiqueta '{l.Descripcion}' ({l.Codigo})?")) return;
        isBusy = true;
        try
        {
            var res = await Api.DeleteAsync(l.Id);
            if (!res.Success) { ToastSvc.Notify(new(ToastType.Danger, res.Error ?? "No se pudo eliminar.")); return; }
            if (selected?.Id == l.Id) selected = null;
            await LoadAsync();
            ToastSvc.Notify(new(ToastType.Success, "Etiqueta eliminada."));
        }
        finally { isBusy = false; }
    }

    private async Task RenderPreviewAsync()
    {
        if (selected is null || string.IsNullOrWhiteSpace(selected.CodigoZpl)) { previewError = "No hay ZPL para previsualizar."; return; }
        if (selected.WidthMm <= 0 || selected.LengthMm <= 0) { previewError = "Dimensiones inválidas."; return; }

        previewLoading = true;
        previewError = "";
        previewDataUrl = null;
        StateHasChanged();
        try
        {
            var req = new ApiLabelService.RenderRequest(selected.CodigoZpl, selected.WidthMm, selected.LengthMm, selected.Dpmm > 0 ? selected.Dpmm : 8);
            var res = await Api.RenderPreviewAsync(req);
            if (res.Success) previewDataUrl = res.DataUrl;
            else previewError = res.Error ?? "No se pudo renderizar.";
        }
        finally { previewLoading = false; }
    }
}
