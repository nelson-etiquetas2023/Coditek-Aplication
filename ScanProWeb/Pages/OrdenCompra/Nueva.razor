@page "/ordencompra/nueva"
@inject IOrdenCompraService servicio
@inject ToastService ToastService
@inject NavigationManager Navigation
@using ScanProWeb.Services.OrdenCompra

<PageTitle>Nueva Orden de Compra</PageTitle>

<div class="d-flex justify-content-between align-items-center mt-0">
    <h3 class="mb-0"><Icon Name="IconName.Cart" Size="IconSize.x2" /> Nueva Orden de Compra</h3>
    <button class="btn btn-secondary" type="button" @onclick="Cancelar">
        <Icon Name="IconName.ArrowLeft" /> Volver
    </button>
</div>

<div class="card mt-3 mb-3">
    <div class="card-header fw-semibold">Documento</div>
    <div class="card-body">
        <div class="mb-2">
            <label class="form-label small fw-semibold">Número</label>
            <input type="text" class="form-control" value="@(string.IsNullOrEmpty(oc.Numero) ? "generando..." : oc.Numero)" disabled />
        </div>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Proveedor</label>
            <input type="text" class="form-control" @bind="oc.Proveedor" placeholder="Proveedor" />
        </div>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Fecha</label>
            <input type="datetime-local" class="form-control" @bind="oc.Fecha" />
        </div>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Estado</label>
            <input type="text" class="form-control" @bind="oc.Estado" placeholder="Estado" />
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-success" type="button" @onclick="Guardar" disabled="@guardando">
        <Icon Name="IconName.Floppy2Fill" /> Guardar
    </button>
    <button class="btn btn-secondary" type="button" @onclick="Cancelar" disabled="@guardando">
        <Icon Name="IconName.XCircle" /> Cancelar
    </button>
</div>

@code {
    private OrdenCompraDto oc = new() { Fecha = DateTime.Now, Estado = "Pendiente" };
    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        oc.Numero = await servicio.GetNextNumAsync();
    }

    private async Task Guardar()
    {
        if (guardando) return;
        if (string.IsNullOrWhiteSpace(oc.Proveedor))
        {
            ToastService.Notify(new(ToastType.Danger, "Debe ingresar el proveedor."));
            return;
        }

        guardando = true;
        StateHasChanged();
        try
        {
            var ok = await servicio.AddAsync(oc);
            if (ok)
            {
                ToastService.Notify(new(ToastType.Success, $"Orden {oc.Numero} guardada correctamente."));
                Navigation.NavigateTo("/ordencompra");
            }
            else
            {
                ToastService.Notify(new(ToastType.Danger, "No se pudo guardar la orden de compra."));
            }
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/ordencompra");
    }
}
