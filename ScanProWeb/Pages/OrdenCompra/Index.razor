@page "/ordencompra"
@inject IOrdenCompraService servicio
@inject IJSRuntime JS
@inject ToastService ToastSvc
@inject NavigationManager Navigation
@using ScanProWeb.Services.OrdenCompra
@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Órdenes de Compra</PageTitle>

<div class="d-flex justify-content-between align-items-center mt-0">
    <div class="d-flex align-items-center gap-2">
        <h2 class="mb-0"><Icon Name="IconName.BoxSeam" Size="IconSize.x2" /> Órdenes de Compra</h2>
    </div>
    <button class="btn btn-primary" type="button" @onclick='() => Navigation.NavigateTo("/ordencompra/nueva")'>
        <Icon Name="IconName.PlusLg" /> Nueva
    </button>
</div>

@if (ordenes is null)
{
    <p class="mt-3">Cargando...</p>
}
else
{
    <QuickGrid Items="ordenes.AsQueryable()" Class="table table-striped mt-3">
        <PropertyColumn Property="@(o => o.Numero)" Title="Número" />
        <PropertyColumn Property="@(o => o.Fecha)" Title="Fecha" Format="dd/MM/yyyy" />
        <PropertyColumn Property="@(o => o.Proveedor)" Title="Proveedor" />
        <PropertyColumn Property="@(o => o.Estado)" Title="Estado" />
        <TemplateColumn Title="Acciones">
            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => Eliminar(context.Numero)">
                <Icon Name="IconName.Trash" /> Eliminar
            </button>
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private List<OrdenCompraDto>? ordenes;

    protected override async Task OnInitializedAsync()
    {
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        ordenes = await servicio.GetOrdersAsync();
        StateHasChanged();
    }

    private async Task Eliminar(string numero)
    {
        bool confirmado = false;
        try
        {
            confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la orden {numero}?");
        }
        catch
        {
            confirmado = true;
        }
        if (!confirmado) return;

        var ok = await servicio.DeleteAsync(numero);
        if (ok)
        {
            ToastSvc.Notify(new(ToastType.Success, $"Orden {numero} eliminada."));
            await RecargarAsync();
        }
        else
        {
            ToastSvc.Notify(new(ToastType.Danger, $"No se pudo eliminar la orden {numero}."));
        }
    }
}
