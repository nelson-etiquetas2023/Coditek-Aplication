            <div id="label-print-area" class="border p-3 rounded bg-white" style="max-width:320px; margin:0 auto;">
                <div class="fw-bold fs-5 text-truncate">@labelProduct.Product_Name</div>
                <div class="text-muted small">@labelProduct.Product_Type · @labelProduct.Unidad</div>
                <div class="my-2 py-2 border rounded text-center font-monospace fs-4 letter-spacing">@(string.IsNullOrWhiteSpace(labelProduct.Codebar) ? (string.IsNullOrWhiteSpace(labelProduct.Product_Code) ? "SIN CODIGO" : labelProduct.Product_Code) : labelProduct.Codebar)</div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="font-monospace">@(string.IsNullOrWhiteSpace(labelProduct.Codebar) ? labelProduct.Product_Code : labelProduct.Codebar)</span>
                    <strong class="fs-4">@labelProduct.Price.ToString("C")</strong>
                </div>
                <div class="small text-muted mt-1">ID @labelProduct.Product_id</div>
            </div>
            <div class="form-text mt-2 text-center">ZPL de ejemplo: <code>^XA^PW406^LL406^FO10,10^A0N,28,28^FD@(labelProduct.Product_Name)^FS^FO10,40^BCN,50,N,N,N^FD@(string.IsNullOrWhiteSpace(labelProduct.Codebar) ? labelProduct.Product_Code : labelProduct.Codebar)^FS^XZ</code></div>
        }
    </BodyTemplate>
    <FooterTemplate>
