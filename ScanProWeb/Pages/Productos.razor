    private async Task LoadSelectedImportFile()
    {
        if (importSelectedFile is null) return;
        isImportLoading = true;
        importLastSummary = null;
        StateHasChanged();
        try
        {
            const long maxSize = 20 * 1024 * 1024;
            byte[] buffer;
            using (var source = importSelectedFile.OpenReadStream(maxAllowedSize: maxSize))
            using (var ms = new MemoryStream())
            {
                await source.CopyToAsync(ms);
                buffer = ms.ToArray();
            }

            // Refrescar productos para validar contra el estado actual del sistema al cargar la hoja
            List<ApiProductService.Product> latestProducts = new();
            try { latestProducts = await Api.GetProductsAsync() ?? new(); } catch { latestProducts = new(); }
            if (latestProducts.Count > 0 || products is null)
            {
                products = latestProducts;
            }

            if (importUploadModal is not null) await importUploadModal.HideAsync();
            await Task.Yield();

            using var readMs = new MemoryStream(buffer);
            ParseImportWorkbook(readMs);
            var invalid = importRows.Count(r => !r.IsValid);
            var warnings = importRows.Count(r => r.IsValid && r.HasWarning);
            var existentes = products?.Count ?? 0;
            var msg = $"Archivo cargado: {importRows.Count} fila(s). Validadas contra {existentes} producto(s) del sistema: {invalid} con error, {warnings} con advertencia.";
            ToastSvc.Notify(new(invalid == 0 ? (warnings == 0 ? ToastType.Success : ToastType.Warning) : ToastType.Warning, msg));
            if (existentes == 0)
            {
                importLastSummaryCss = "alert-warning";
                importLastSummary = "No se pudieron cargar productos del sistema para validar duplicados (código/nombre). Verifica que la API esté disponible y la sesión sea válida.";
            }
        }
        catch (Exception ex)
        {
            importRows.Clear();
            ToastSvc.Notify(new(ToastType.Danger, $"Error al leer el archivo: {ex.Message}"));
        }
        finally
        {
            isImportLoading = false;
            importSelectedFile = null;
            importSelectedFileName = null;
            StateHasChanged();
        }
    }


    private void ParseImportWorkbook(Stream stream)
    {
        importRows.Clear();
        using var workbook = new XLWorkbook(stream);
        var ws = workbook.Worksheets.FirstOrDefault();
        if (ws is null) throw new InvalidOperationException("El archivo no contiene hojas.");

        var headerMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var lastCol = ws.Row(1).LastCellUsed()?.Address.ColumnNumber ?? 0;
        for (var c = 1; c <= lastCol; c++)
        {
            var h = ws.Cell(1, c).GetString().Trim();
            if (!string.IsNullOrWhiteSpace(h)) headerMap[h] = c;
        }
        int Col(params string[] keys)
        {
            foreach (var kv in headerMap)
                foreach (var k in keys)
                    if (kv.Key.Contains(k, StringComparison.OrdinalIgnoreCase)) return kv.Value;
            return -1;
        }
        var cCode = Col("product_code", "cï¿½digo", "codigo");
        var cName = Col("nombre");
        var cCat = Col("categor", "product_type", "tipo");
        var cUnit = Col("unidad");
        var cPrice = Col("precio");
        var cBar = Col("barra", "codebar", "barcode");
        var cMarca = Col("marca");
        var cPeso = Col("peso");
        var cCosto = Col("costo");
        var cStock = Col("stock", "existencia");
        if (cCode < 0 && cName < 0 && cCat < 0 && lastCol >= 5) { cCode = 1; cName = 2; cCat = 3; cUnit = 4; cPrice = 5; }

        var lastRow = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= lastRow; r++)
        {
            var row = ws.Row(r);
            if (row.IsEmpty()) continue;
            var item = new ImportRow
            {
                RowNumber = importRows.Count + 1,
                Product_Code = GetCellStr(ws, r, cCode),
                Product_Name = GetCellStr(ws, r, cName),
                Product_Type = GetCellStr(ws, r, cCat),
                Unidad = GetCellStr(ws, r, cUnit),
                Price = GetCellDouble(ws, r, cPrice),
                Codebar = GetCellStr(ws, r, cBar),
                Marca = GetCellStr(ws, r, cMarca),
                Peso = GetCellStr(ws, r, cPeso),
                Costo = GetCellDecimal(ws, r, cCosto),
                Stock = GetCellDouble(ws, r, cStock)
            };
            importRows.Add(item);
        }

        ValidateImportRows();
    }

    private void ValidateImportRows()
    {
        var existing = products ?? new List<ApiProductService.Product>();
        var existingCodes = existing
            .Where(p => !string.IsNullOrWhiteSpace(p.Product_Code))
            .GroupBy(p => NormalizeCode(p.Product_Code), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var existingNames = existing
            .Where(p => !string.IsNullOrWhiteSpace(p.Product_Name))
            .GroupBy(p => NormalizeName(p.Product_Name), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var existingCompactNames = existing
            .Where(p => !string.IsNullOrWhiteSpace(p.Product_Name))
            .GroupBy(p => CompactName(p.Product_Name), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var seenCodes = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var seenNames = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var seenCompactNames = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach (var row in importRows)
        {
            var errors = new List<string>();
            var code = NormalizeSpaces(row.Product_Code);
            var name = NormalizeSpaces(row.Product_Name);
            row.Product_Code = code;
            row.Product_Name = name;
            row.Product_Type = NormalizeSpaces(row.Product_Type);
            row.Unidad = NormalizeSpaces(row.Unidad);

            var codeKey = NormalizeCode(code);
            var nameKey = NormalizeName(name);
            var compactNameKey = CompactName(name);

            if (string.IsNullOrWhiteSpace(code)) errors.Add("Código requerido");
            if (string.IsNullOrWhiteSpace(name)) errors.Add("Nombre requerido");
            if (string.IsNullOrWhiteSpace(row.Product_Type)) errors.Add("Categoría requerida");
            if (string.IsNullOrWhiteSpace(row.Unidad)) errors.Add("Unidad requerida");
            if (row.Price <= 0) errors.Add("El precio debe ser mayor a 0");

            if (!string.IsNullOrWhiteSpace(codeKey))
            {
                if (existingCodes.TryGetValue(codeKey, out var pCode))
                    errors.Add($"El código \"{code}\" ya existe en el sistema (ID {pCode.Product_id}, \"{pCode.Product_Code}\")");
                else if (seenCodes.TryGetValue(codeKey, out var otherRow))
                    errors.Add($"Código duplicado en la hoja (fila {otherRow})");
                else
                    seenCodes[codeKey] = row.RowNumber;
            }

            ApiProductService.Product? nameMatch = null;
            if (!string.IsNullOrWhiteSpace(nameKey) && existingNames.TryGetValue(nameKey, out var pByName))
                nameMatch = pByName;
            else if (!string.IsNullOrWhiteSpace(compactNameKey) && existingCompactNames.TryGetValue(compactNameKey, out var pByCompact))
                nameMatch = pByCompact;

            row.Warning = string.Empty;
            if (!string.IsNullOrWhiteSpace(nameKey))
            {
                if (nameMatch is not null)
                    errors.Add($"El producto \"{name}\" ya existe en el sistema (ID {nameMatch.Product_id}, \"{nameMatch.Product_Name}\")");
                else if (seenNames.TryGetValue(nameKey, out var otherRow))
                    errors.Add($"Nombre duplicado en la hoja (fila {otherRow})");
                else if (!string.IsNullOrWhiteSpace(compactNameKey) && seenCompactNames.TryGetValue(compactNameKey, out var otherRowCompact))
                    errors.Add($"Nombre duplicado en la hoja (fila {otherRowCompact})");
                else
                {
                    seenNames[nameKey] = row.RowNumber;
                    if (!string.IsNullOrWhiteSpace(compactNameKey)) seenCompactNames[compactNameKey] = row.RowNumber;

                    var similar = FindSimilarProductName(name, existing);
                    if (similar is not null)
                        row.Warning = $"Nombre parecido a un producto existente: \"{similar.Product_Name}\" (ID {similar.Product_id}). Verifica si es el mismo producto.";
                }
            }

            row.IsValid = errors.Count == 0;
            row.Error = string.Join("; ", errors);
        }
    }

    private static string NormalizeSpaces(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var parts = value.Trim()
            .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries); // all whitespace
        return string.Join(" ", parts);
    }

    private static string NormalizeCode(string? value) => NormalizeSpaces(value).ToUpperInvariant();

    private static string NormalizeName(string? value)
    {
        var s = NormalizeSpaces(value);
        if (string.IsNullOrEmpty(s)) return string.Empty;
        s = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var ch in s)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(char.ToUpperInvariant(ch));
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    private static string CompactName(string? value)
    {
        var n = NormalizeName(value);
        if (string.IsNullOrEmpty(n)) return string.Empty;
        var sb = new System.Text.StringBuilder(n.Length);
        foreach (var ch in n)
        {
            if (!char.IsWhiteSpace(ch)) sb.Append(ch);
        }
        return sb.ToString();
    }

    private static ApiProductService.Product? FindSimilarProductName(string name, List<ApiProductService.Product> existing)
    {
        if (string.IsNullOrWhiteSpace(name) || existing.Count == 0) return null;
        ApiProductService.Product? best = null;
        double bestScore = 0;
        foreach (var p in existing)
        {
            if (string.IsNullOrWhiteSpace(p.Product_Name)) continue;
            var score = NameSimilarity(name, p.Product_Name);
            if (score > bestScore)
            {
                bestScore = score;
                best = p;
            }
        }
        // Umbral: parecido pero no igual (los iguales ya se detectan como duplicado bloqueante)
        return bestScore >= 0.72 ? best : null;
    }

    private static double NameSimilarity(string a, string b)
    {
        var na = NormalizeName(a);
        var nb = NormalizeName(b);
        if (string.IsNullOrEmpty(na) || string.IsNullOrEmpty(nb)) return 0;
        if (string.Equals(na, nb, StringComparison.Ordinal)) return 1;

        var ca = CompactName(a);
        var cb = CompactName(b);
        var compactScore = (string.IsNullOrEmpty(ca) || string.IsNullOrEmpty(cb)) ? 0 : SequenceSimilarity(ca, cb);

        var ta = na.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var tb = nb.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var tokenScore = TokenSimilarity(ta, tb);

        return Math.Max(compactScore, tokenScore);
    }

    private static double TokenSimilarity(string[] a, string[] b)
    {
        if (a.Length == 0 || b.Length == 0) return 0;
        var setA = new HashSet<string>(a, StringComparer.Ordinal);
        var setB = new HashSet<string>(b, StringComparer.Ordinal);
        var intersect = setA.Count(x => setB.Contains(x));
        var union = setA.Union(setB, StringComparer.Ordinal).Count();
        var jaccard = union == 0 ? 0 : (double)intersect / union;
        var dice = (setA.Count + setB.Count) == 0 ? 0 : (2.0 * intersect) / (setA.Count + setB.Count);
        return Math.Max(jaccard, dice);
    }

    private static double SequenceSimilarity(string a, string b)
    {
        if (a.Length == 0 && b.Length == 0) return 1;
        var maxLen = Math.Max(a.Length, b.Length);
        if (maxLen == 0) return 1;
        var dist = LevenshteinDistance(a, b);
        return 1.0 - ((double)dist / maxLen);
    }

    private static int LevenshteinDistance(string s, string t)
    {
        var n = s.Length;
        var m = t.Length;
        if (n == 0) return m;
        if (m == 0) return n;
        var d = new int[n + 1, m + 1];
        for (var i = 0; i <= n; i++) d[i, 0] = i;
        for (var j = 0; j <= m; j++) d[0, j] = j;
        for (var i = 1; i <= n; i++)
        {
            for (var j = 1; j <= m; j++)
            {
                var cost = s[i - 1] == t[j - 1] ? 0 : 1;
                d[i, j] = Math.Min(Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1), d[i - 1, j - 1] + cost);
            }
        }
        return d[n, m];
    }

    private static string GetCellStr(IXLWorksheet ws, int r, int c) => c < 1 ? string.Empty : (ws.Cell(r, c).GetFormattedString()?.Trim() ?? string.Empty);
    private static double GetCellDouble(IXLWorksheet ws, int r, int c)
    {
        if (c < 1) return 0;
        var cell = ws.Cell(r, c);
        if (cell.TryGetValue<double>(out var d)) return d;
        return TryParseDecimalFlexible(cell.GetFormattedString(), out var v) ? v : 0;
    }
    private static decimal GetCellDecimal(IXLWorksheet ws, int r, int c)
    {
        if (c < 1) return 0;
        var cell = ws.Cell(r, c);
        if (cell.TryGetValue<decimal>(out var d)) return d;
        return TryParseDecimalFlexible(cell.GetFormattedString(), out var v) ? (decimal)v : 0;
    }

    private async Task SaveImportToDatabase()
    {
        var toSave = importRows.Where(r => r.IsValid).ToList();
        if (toSave.Count == 0) return;
        isImportSaving = true;
        importSaveTotal = toSave.Count;
        importSaveProgress = 0;
        importLastSummary = null;
        foreach (var r in importRows) { r.ResultMessage = null; r.ResultCss = string.Empty; }
        StateHasChanged();
        var ok = 0; var fail = 0;
        foreach (var r in toSave)
        {
            importSaveProgress++;
            StateHasChanged();
            try
            {
                var product = new ApiProductService.Product
                {
                    Product_id = 0,
                    Product_Code = r.Product_Code,
                    Product_Name = r.Product_Name,
                    Product_Type = r.Product_Type,
                    Unidad = r.Unidad,
                    Price = r.Price,
                    Codebar = r.Codebar ?? string.Empty,
                    Marca = r.Marca ?? string.Empty,
                    Peso = string.IsNullOrWhiteSpace(r.Peso) ? null : r.Peso,
                    Costo = r.Costo,
                    Stock = r.Stock,
                    IsActive = true
                };
                var res = await Api.CreateProductWithDetailsAsync(product);
                if (res.Success) { ok++; r.ResultMessage = "Guardado"; r.ResultCss = "text-success"; }
                else { fail++; r.ResultMessage = string.IsNullOrWhiteSpace(res.Error) ? "Error" : res.Error; r.ResultCss = "text-danger"; }
            }
            catch (Exception ex) { fail++; r.ResultMessage = ex.Message; r.ResultCss = "text-danger"; }
        }
        isImportSaving = false;
        importSaveProgress = importSaveTotal;
        importLastSummaryCss = fail == 0 ? "alert-success" : (ok > 0 ? "alert-warning" : "alert-danger");
        importLastSummary = $"Proceso finalizado: {ok} guardado(s), {fail} con error, {importRows.Count - toSave.Count} omitido(s) por validaciï¿½n.";
        ToastSvc.Notify(new(fail == 0 ? ToastType.Success : ToastType.Warning, importLastSummary));
        if (ok > 0)
        {
            await LoadProducts();
            Buscar();
        }
        StateHasChanged();
    }

    private sealed class ImportRow
    {
        public int RowNumber { get; set; }
        public string Product_Code { get; set; } = string.Empty;
        public string Product_Name { get; set; } = string.Empty;
        public string Product_Type { get; set; } = string.Empty;
        public string Unidad { get; set; } = string.Empty;
        public double Price { get; set; }
        public string Codebar { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Peso { get; set; } = string.Empty;
        public decimal Costo { get; set; }
        public double Stock { get; set; }
        public bool IsValid { get; set; }
        public string Error { get; set; } = string.Empty;
        public bool HasWarning => !string.IsNullOrWhiteSpace(Warning);
        public string Warning { get; set; } = string.Empty;
        public string? ResultMessage { get; set; }
        public string ResultCss { get; set; } = string.Empty;
    }
}
