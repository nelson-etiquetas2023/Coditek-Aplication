<CategoryUnitManager @ref="categoryUnitManager" OnChanged="ReloadCategoryUnitLists" OnCategorySelected="OnCategorySelectedFromManager" OnUnitSelected="OnUnitSelectedFromManager" />

@code {
    private List<ApiProductService.Product>? products;
    private IEnumerable<ApiProductService.Product> productsFiltered = new List<ApiProductService.Product>();
    private List<ApiConfigService.CategoryDto> categorias = new();
    private List<ApiConfigService.ProductUnitDto> unidades = new();
    private Modal? createModal;
    private CategoryUnitManager categoryUnitManager = default!;
    private ApiProductService.Product editProduct = new();
    private ApiProductService.Product? selectedProduct;
    private bool isEdit;
    private bool isSaving;
    private int editingId;
    private string searchText = "";
    private string filtroTipo = "todos";
    private string activeDetailTab = "detalle";
    private bool IsFilterActive => !string.IsNullOrWhiteSpace(searchText);
    private string productViewMode = "grid";
    private Modal? labelModal = null;
    private ApiProductService.Product? labelProduct = null;
    private Modal? reportModal = null;
    private int ReportTotalProducts => productsFiltered?.Count() ?? 0;
    private double ReportTotalStock => productsFiltered?.Sum(p => p.Stock) ?? 0;
    private decimal ReportTotalCostValue => productsFiltered?.Sum(p => (decimal)p.Stock * p.Costo) ?? 0;
    private double ReportTotalPriceValue => productsFiltered?.Sum(p => p.Stock * p.Price) ?? 0;
    private List<(string Categoria, int Count, double StockSum, decimal Value)> ReportByCategory =>
        (productsFiltered ?? new List<ApiProductService.Product>())
            .GroupBy(p => string.IsNullOrWhiteSpace(p.Product_Type) ? "(Sin categoría)" : p.Product_Type.Trim())
            .OrderBy(g => g.Key)
            .Select(g => (Categoria: g.Key, Count: g.Count(), StockSum: g.Sum(x => x.Stock), Value: g.Sum(x => (decimal)x.Stock * x.Costo)))
            .ToList();
    private List<ApiProductService.Product> ReportLowStock =>
        (productsFiltered ?? new List<ApiProductService.Product>())
            .Where(p => p.Stock_Mix > 0 && p.Stock <= p.Stock_Mix)
            .OrderBy(p => p.Product_Name)
            .ToList();

    // Detalle en modo edición: Editar arriba -> Guardar/Cancelar -> volver a Editar
    private bool isDetailEditing = false;
    private ApiProductService.Product? detailBackup;

    // Fotos detalle: modal de ampliación + edición inline al editar
    private Modal? photoModal = null;
    private string? maximizedImage = null;
    private int maximizedIndex = -1;
    private int detailNextImageSlot = 0;
    private InputFile detailFileInput = default!;

    // Fotos modal (agregar producto): sin URL, archivo + vista previa
    private InputFile fileInput = default!;
    private (string FileName, string ContentType, byte[] Data)?[] modalImages = new (string, string, byte[])?[3];
    private int?[] modalExistingImageIds = new int?[3];
    private bool[] modalImageRemoved = new bool[3];
    private string[] imagePreviews = new string[3];
    private string[] imageNames = new string[3];
    private int nextImageSlot = 0;

    // Fotos (página de detalle): sin URL, archivo + vista previa
    private (string FileName, string ContentType, byte[] Data)?[] detailImages = new (string, string, byte[])?[3];
    private int?[] detailExistingImageIds = new int?[3];
    private bool[] detailImageRemoved = new bool[3];
    private string[] detailImagePreviews = new string[3];

    private bool isProductsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = await ConfigApi.GetCategoriesAsync();
            unidades = await ConfigApi.GetProductUnitsAsync();
            await LoadProducts();
        }
        finally
        {
            isProductsLoading = false;
        }
    }

    private async Task OpenCategoryManager() => await categoryUnitManager.ShowCategoriesAsync();
    private async Task OpenUnitManager() => await categoryUnitManager.ShowUnitsAsync();
    private async Task ReloadCategoryUnitLists()
    {
        categorias = await ConfigApi.GetCategoriesAsync();
        unidades = await ConfigApi.GetProductUnitsAsync();
        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        products = await Api.GetProductsAsync();
        productsFiltered = (products ?? new()).OrderByDescending(p => p.Product_id).ToList();

        if (productsFiltered.Any())
        {
            if (selectedProduct is null || !productsFiltered.Any(p => p.Product_id == selectedProduct.Product_id))
            {
                selectedProduct = productsFiltered.First();
                isDetailEditing = false;
                detailBackup = null;
                await LoadDetailImagesAsync();
            }
        }
        else
        {
            selectedProduct = null;
            isDetailEditing = false;
            detailBackup = null;
            detailImagePreviews = new string[3];
        }
    }

    private void OnSearchTextChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        Buscar();
    }

    private void OnFiltroTipoChanged(string value)
    {
        filtroTipo = value;
        if (value == "todos")
        {
            searchText = string.Empty;
        }
        Buscar();
    }

    private void OnCategorySelectedFromManager(string name)
    {
        if (isDetailEditing && selectedProduct is not null)
            selectedProduct.Product_Type = name;
        else
            editProduct.Product_Type = name;
        StateHasChanged();
    }

    private void OnUnitSelectedFromManager(string name)
    {
        if (isDetailEditing && selectedProduct is not null)
            selectedProduct.Unidad = name;
        else
            editProduct.Unidad = name;
        StateHasChanged();
    }

    private void Buscar()
    {
        if (products is null)
        {
            return;
        }

        var filtro = searchText?.Trim() ?? string.Empty;
        var q = products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtro))
        {
            q = filtroTipo switch
            {
                "categoria" => q.Where(p => (p.Product_Type ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                "unidad" => q.Where(p => (p.Unidad ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                "marca" => q.Where(p => (p.Marca ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                _ => q.Where(p =>
                    p.Product_id.ToString().Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Code ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Name ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Type ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Unidad ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Marca ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase))
            };
        }

        productsFiltered = q.OrderByDescending(p => p.Product_id).ToList();

        if (productsFiltered.Any())
        {
            // Si el seleccionado actual sigue en el filtro, mantenerlo; si no, tomar el primero.
            // Esto refresca los datos del tabpage (Detalle + Otros + fotos) al cambiar el filtro.
            if (selectedProduct is null || !productsFiltered.Any(p => p.Product_id == selectedProduct.Product_id))
            {
                selectedProduct = productsFiltered.First();
                isDetailEditing = false;
                detailBackup = null;
                _ = LoadDetailImagesAsync();
            }
        }
        else
        {
            selectedProduct = null;
            isDetailEditing = false;
            detailBackup = null;
            detailImagePreviews = new string[3];
        }
    }

