@page "/productos"
@inject ApiProductService Api
@inject ApiConfigService ConfigApi
@inject IJSRuntime JS
@inject ToastService ToastSvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@using ClosedXML.Excel

<PageTitle>Productos</PageTitle>

@if (isProductsLoading)
{
    <div class="products-loading" role="status" aria-live="polite" aria-label="Cargando productos…">
        <span class="products-loading-spinner" aria-hidden="true"></span>
        <h3 class="products-loading-title">Cargando productos…</h3>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 d-flex align-items-center gap-2"><Icon Name="IconName.Box" Size="IconSize.x2" /> Productos
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Vista de productos"><Icon Name="IconName.ThreeDotsVertical" /></button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><button class="dropdown-item @(productViewMode == "grid" ? "active" : "")" type="button" @onclick='() => productViewMode = "grid"'><Icon Name="IconName.Grid3X3GapFill" /> Vista Grid</button></li>
                <li><button class="dropdown-item @(productViewMode == "list" ? "active" : "")" type="button" @onclick='() => productViewMode = "list"'><Icon Name="IconName.List" /> Vista Lista</button></li>
            </ul>
        </div>
    </h2>
    <div class="d-flex gap-2">
        <button class="btn border border-dark text-dark" style="background-color:#fff;" type="button" @onclick="OpenNew">
            <Icon Name="IconName.PlusLg" /> Nuevo
        </button>
        <button class="btn border border-dark text-dark" style="background-color:#fff;" type="button" @onclick="DeleteSelectedProduct" disabled="@(selectedProduct is null)">
            <Icon Name="IconName.Trash" /> Eliminar
        </button>

        <button class="btn border border-dark text-dark" style="background-color:#fff;" type="button" @onclick="OpenProductReport">
            <Icon Name="IconName.BarChartFill" /> Reporte
        </button>
    </div>
</div>

<div class="d-flex gap-3">
    <div style="flex: 0 0 calc(30% - 8px); min-width: 0;">
        <div class="card h-100">
            <div class="card-body">
                <div class="mb-3">
                    <input id="buscadorProductos" class="form-control" type="text" value="@searchText" @oninput="OnSearchTextChanged" placeholder="Buscar por ID, código o nombre" aria-label="Buscador" />
                </div>
                <div class="mb-2 d-flex align-items-center gap-2 flex-nowrap product-filter-radios">
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="radio" name="filtroTipo" checked="@(filtroTipo == "todos")" @onchange='() => OnFiltroTipoChanged("todos")' />
                        <span class="form-check-label">Todos</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="radio" name="filtroTipo" checked="@(filtroTipo == "categoria")" @onchange='() => OnFiltroTipoChanged("categoria")' />
                        <span class="form-check-label">Categoría</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="radio" name="filtroTipo" checked="@(filtroTipo == "unidad")" @onchange='() => OnFiltroTipoChanged("unidad")' />
                        <span class="form-check-label">Unidad</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="radio" name="filtroTipo" checked="@(filtroTipo == "marca")" @onchange='() => OnFiltroTipoChanged("marca")' />
                        <span class="form-check-label">Marca</span>
                    </label>
                </div>

                @if (products is null)
                {
                    <p class="mb-0 text-muted">Cargando...</p>
                }
                else if (productsFiltered.Count() == 0)
                {
                    <p class="mb-0 text-muted">Sin resultados para el filtro actual.</p>
                }
                else
                {
                    @if (productViewMode == "list")
                    {
                        <div class="productos-list" style="max-height: 600px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 6px; margin-top: 4px; background:#fff;">
                            @foreach (var p in productsFiltered)
                            {
                                var item = p;
                                var isSel = selectedProduct is not null && p.Product_id == selectedProduct.Product_id;
                                <div class="producto-list-item @(isSel ? "selected" : "")" role="button" @onclick="() => SelectProduct(item)">
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-truncate">@p.Product_Name</div>
                                        <small class="text-muted">ID @p.Product_id · @p.Product_Type</small>
                                    </div>
                                    <button class="btn btn-sm btn-link p-1 text-dark fw-bold" type="button" title="Imprimir etiqueta" aria-label="Imprimir etiqueta" @onclick:stopPropagation="true" @onclick="() => OpenLabelPrint(item)"><Icon Name="IconName.UpcScan" /></button>
                                </div>
                            }
                        </div>
                        <div class="form-text mt-2">Haz clic en un producto para ver el detalle en el tabpage. Vista lista.</div>
                    }
                    else
                    {
                        <div class="productos-grid">
                            <div class="productos-grid-title"><Icon Name="IconName.List" /><h3>Listado de Productos</h3></div>
                            <QuickGrid Items="productsFiltered.AsQueryable()" Class="table table-sm mb-0 products-compact-table">
                                <TemplateColumn Title="#" Class="col-id">
                                    @{
                                        var list = productsFiltered as IList<ApiProductService.Product> ?? productsFiltered.ToList();
                                        var idx = list.IndexOf(context);
                                        var it = idx >= 0 ? list.Count - idx : 0;
                                    }
                                    @it
                                </TemplateColumn>
                                <TemplateColumn Title="Product Name" Class="col-name">
                                    <button class="btn btn-link p-0 text-decoration-none fw-semibold text-start w-100 product-name-text @(selectedProduct is not null && context.Product_id == selectedProduct.Product_id ? "selected-product" : "")" type="button" title="@context.Product_Name" aria-label="@($"Ver detalle de {context.Product_Name}")" @onclick="() => SelectProduct(context)">
                                        @context.Product_Name
                                    </button>
                                </TemplateColumn>
                                <TemplateColumn Title="Cód." Class="col-barcode">
                                    <button class="barcode-print-button" type="button" title="Generar etiqueta de código de barras" aria-label="Generar etiqueta de código de barras" @onclick:stopPropagation="true" @onclick="() => OpenLabelPrint(context)"><Icon Name="IconName.UpcScan" /></button>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="form-text mt-2">Haz clic en el nombre para ver el detalle en el tabpage.</div>
                    }
                }
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center small py-2">
                <strong><Icon Name="IconName.Box" /> Total de productos</strong>
                @if (IsFilterActive)
                {
                    <strong class="fw-bold">@productsFiltered.Count() de @(products?.Count ?? 0)</strong>
                }
                else
                {
                    <strong class="fw-bold">@(products?.Count ?? 0)</strong>
                }
            </div>
        </div>
    </div>

    <div style="flex: 0 0 calc(70% - 8px); min-width: 0;">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <ul class="nav nav-tabs card-header-tabs mb-0" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @ActiveClass("detalle")" type="button" role="tab" aria-selected='@AriaSelected("detalle")' @onclick='() => activeDetailTab = "detalle"'><Icon Name="IconName.FileText" /> Detalle</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @ActiveClass("otros")" type="button" role="tab" aria-selected='@AriaSelected("otros")' @onclick='() => activeDetailTab = "otros"'><Icon Name="IconName.Gear" /> Otros</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @ActiveClass("etiqueta")" type="button" role="tab" aria-selected='@AriaSelected("etiqueta")' @onclick='() => activeDetailTab = "etiqueta"'><Icon Name="IconName.UpcScan" /> Etiqueta</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @ActiveClass("importar")" type="button" role="tab" aria-selected='@AriaSelected("importar")' @onclick='() => activeDetailTab = "importar"'><Icon Name="IconName.FileEarmarkArrowUp" /> Importar</button>
                    </li>
                </ul>
                @if (selectedProduct is not null && activeDetailTab != "importar")
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (!isDetailEditing)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="StartDetailEdit"><Icon Name="IconName.Pencil" /> Editar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="SaveDetailChanges" disabled="@isSaving"><Icon Name="IconName.FloppyFill" /> @(isSaving ? "Guardando..." : "Guardar")</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelDetailEdit" disabled="@isSaving"><Icon Name="IconName.XCircle" /> Cancelar</button>
                        }
                        <div class="form-check form-switch mb-0 ms-1">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="selectedProduct.IsActive" id="activoDetalle" disabled="@(!isDetailEditing)" />
                            <label class="form-check-label fw-semibold small" for="activoDetalle">Activo</label>
                        </div>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (activeDetailTab == "importar")
                {
                    <div class="import-franja d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 mb-3 rounded" style="background-color: var(--color-secondary, #B4D6EA); border: 1px solid var(--color-border, #b7d3e8);">
                        <div class="d-flex align-items-center gap-2">
                            <Icon Name="IconName.FileEarmarkArrowUp" Size="IconSize.x2" />
                            <div>
                                <h5 class="mb-0 fw-bold">Importación de datos desde Excel</h5>
                                <small class="text-muted">Carga masiva de productos</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-dark bg-white" type="button" @onclick="DownloadTemplateExcel" disabled="@(isImportLoading || isImportSaving)">
                                <Icon Name="IconName.FileEarmarkSpreadsheet" /> Descargar plantilla
                            </button>
                            <button class="btn btn-primary" type="button" @onclick="OpenImportUploadModal" disabled="@(isImportLoading || isImportSaving)">
                                <Icon Name="IconName.Upload" /> Cargar datos
                            </button>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div class="flex-grow-1" style="max-width: 420px;">
                            <div class="input-group">
                                <span class="input-group-text"><Icon Name="IconName.Search" /></span>
                                <input class="form-control" type="text" placeholder="Buscar en los datos cargados..." @bind="importSearchText" @bind:event="oninput" disabled="@(importRows.Count == 0)" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (importRows.Count > 0)
                            {
                                <span class="badge bg-secondary">@FilteredImportRows.Count() / @importRows.Count filas</span>
                                <span class="badge bg-success">@importRows.Count(r => r.IsValid && !r.HasWarning) listas</span>
                                @if (importRows.Any(r => r.HasWarning && r.IsValid))
                                {
                                    <span class="badge bg-warning text-dark">@importRows.Count(r => r.HasWarning && r.IsValid) con advertencia</span>
                                }
                                @if (importRows.Any(r => !r.IsValid))
                                {
                                    <span class="badge bg-danger">@importRows.Count(r => !r.IsValid) con errores</span>
                                }
                            }
                            <button class="btn btn-success" type="button" @onclick="SaveImportToDatabase" disabled="@(!CanSaveImport)">
                                @if (isImportSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Guardando @importSaveProgress/@importSaveTotal...</span>
                                }
                                else
                                {
                                    <Icon Name="IconName.FloppyFill" /> <span>Guardar en base de datos</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (isImportLoading)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-primary">
                            <div class="spinner-border mb-3" role="status" style="width:3rem;height:3rem;"><span class="visually-hidden">Cargando...</span></div>
                            <div class="fw-semibold">Cargando datos del archivo...</div>
                            <div class="text-muted small">Por favor espera mientras se procesa la hoja de Excel.</div>
                        </div>
                    }
                    else if (importRows.Count == 0)
                    {
                        <div class="text-center text-muted py-5 border rounded bg-light">
                            <Icon Name="IconName.FileEarmarkSpreadsheet" Size="IconSize.x3" />
                            <div class="mt-2 fw-semibold">No hay datos cargados</div>
                            <div class="small">Descarga la plantilla, complétala y usa <strong>Cargar datos</strong> para montar la hoja de Excel.</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive border rounded import-grid-wrap" style="max-height: 52vh; overflow:auto;">
                            <QuickGrid Items="FilteredImportRows.AsQueryable()" Class="table table-sm table-striped table-hover mb-0 align-middle" RowClass="GetImportRowClass">
                                <PropertyColumn Property="@(r => r.RowNumber)" Title="#" Sortable="true" />
                                <PropertyColumn Property="@(r => r.Product_Code)" Title="Código" Sortable="true" />
                                <PropertyColumn Property="@(r => r.Product_Name)" Title="Nombre" Sortable="true" />
                                <PropertyColumn Property="@(r => r.Product_Type)" Title="Categoría" Sortable="true" />
                                <PropertyColumn Property="@(r => r.Unidad)" Title="Unidad" Sortable="true" />
                                <TemplateColumn Title="Precio" Sortable="true">@context.Price.ToString("N2")</TemplateColumn>
                                <TemplateColumn Title="Estado">
                                    @if (!context.IsValid)
                                    {
                                        <span class="badge bg-danger" title="@context.Error">Error</span>
                                    }
                                    else if (context.HasWarning)
                                    {
                                        <span class="badge bg-warning text-dark" title="@context.Warning">Advertencia</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Listo</span>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Detalle">
                                    @if (!context.IsValid)
                                    {
                                        <small class="text-danger fw-semibold">@context.Error</small>
                                    }
                                    else
                                    {
                                        @if (context.HasWarning)
                                        {
                                            <div><small class="text-warning-emphasis fw-semibold">@context.Warning</small></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(context.ResultMessage))
                                        {
                                            <div><small class="@context.ResultCss">@context.ResultMessage</small></div>
                                        }
                                    }
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(importLastSummary))
                    {
                        <div class="alert @importLastSummaryCss mt-3 mb-0">@importLastSummary</div>
                    }
                }
                else if (selectedProduct is null)
                {
                    <div class="text-muted">Seleccione un producto para ver su detalle.</div>
                }
                else
                {
                    <fieldset disabled="@(!isDetailEditing)" style="border:0;padding:0;margin:0;min-width:0;">
                    @if (activeDetailTab == "detalle")
                    {
                        <div class="detail-photos mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 fw-semibold">Fotos del producto (3)</h6>
                                <small class="text-muted">@(isDetailEditing ? "Clic en cuadro para cambiar foto" : "Clic para ampliar")</small>
                            </div>
                            <div class="row g-2">
                                @for (var i = 0; i < 3; i++)
                                {
                                    var index = i;
                                    <div class="col-md-4">
                                        <div class="detail-photo-box @(isDetailEditing ? "edit-mode" : "")" @onclick="() => OnDetailPhotoClicked(index)" title="@(isDetailEditing ? "Clic para cambiar o agregar foto" : "Clic para ampliar")">
                                            @if (!string.IsNullOrWhiteSpace(detailImagePreviews[index]))
                                            {
                                                <img src="@detailImagePreviews[index]" alt="Foto @(index + 1)" class="detail-photo-img" />
                                                @if (isDetailEditing)
                                                {
                                                    <button type="button" class="btn-photo-action" @onclick:stopPropagation="true" @onclick="() => PickDetailPhoto(index)" title="Cambiar foto"><Icon Name="IconName.HandIndexThumb" /></button>
                                                    <button type="button" class="btn-remove-image" @onclick:stopPropagation="true" @onclick="() => RemoveDetailImage(index)" title="Quitar foto"><Icon Name="IconName.XLg" /></button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn-photo-zoom" @onclick:stopPropagation="true" @onclick="() => OpenPhotoViewerFor(detailImagePreviews, index)" title="Ampliar"><Icon Name="IconName.ZoomIn" /></button>
                                                }
                                            }
                                            else
                                            {
                                                <div class="detail-photo-placeholder">
                                                    <div class="photo-placeholder-icon"><Icon Name="IconName.CameraFill" /></div>
                                                    <div class="small fw-semibold">Foto @(index + 1)</div>
                                                    <div class="small text-muted">@(isDetailEditing ? "Clic para agregar foto" : "Sin imagen")</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <InputFile @ref="detailFileInput" OnChange="OnDetailPhotoSelected" accept="image/*" hidden data-detail-photo />
                            <div class="form-text mt-1">Fotos guardadas como archivo en el servidor (no URL). Edita con <strong>Editar</strong> para cambiarlas, luego <strong>Guardar</strong>; sin editar, clic para ampliar.</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Product ID (auto)</label>
                                    <input class="form-control form-control-sm" type="text" value="@selectedProduct.Product_id" disabled />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Código</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Product_Code" placeholder="Código del producto" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Nombre</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Product_Name" placeholder="Nombre del producto" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Categoría</label>
                                    <div class="input-group input-group-sm">
                                        <input class="form-control" type="text" @bind="selectedProduct.Product_Type" list="catListDetail" placeholder="Categoría" />
                                        <button type="button" class="btn btn-outline-secondary" @onclick="OpenCategoryManager" title="Gestionar categorías" disabled="@(!isDetailEditing)"><Icon Name="IconName.Gear" /></button>
                                    </div>
                                    <datalist id="catListDetail">
                                        @foreach (var c in categorias.Where(cat => cat.IsActive))
                                        {
                                            <option value="@c.Name" />
                                        }
                                    </datalist>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold">Unidad</label>
                                        <div class="input-group input-group-sm">
                                            <input class="form-control" type="text" @bind="selectedProduct.Unidad" list="unitListDetail" placeholder="Unidad" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="OpenUnitManager" title="Gestionar unidades" disabled="@(!isDetailEditing)"><Icon Name="IconName.Gear" /></button>
                                        </div>
                                        <datalist id="unitListDetail">
                                            @foreach (var u in unidades.Where(unit => unit.IsActive))
                                            {
                                                <option value="@u.Name" />
                                            }
                                        </datalist>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold">Peso</label>
                                        <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Peso" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Marca</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Marca" placeholder="Marca" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Precio</label>
                                    <input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="selectedProduct.Price" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Costo</label>
                                    <input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="selectedProduct.Costo" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Stock (Existencia)</label>
                                    <input class="form-control form-control-sm" type="number" step="0.01" @bind="selectedProduct.Stock" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Stock mínimo</label>
                                    <input class="form-control form-control-sm" type="number" step="0.01" @bind="selectedProduct.Stock_Mix" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Stock máximo</label>
                                    <input class="form-control form-control-sm" type="number" step="0.01" @bind="selectedProduct.Stock_Max" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <div class="small fw-semibold text-muted mb-2">Auditoría</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 small align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Evento</th>
                                        <th>Fecha y hora</th>
                                        <th>Usuario</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Creación</td>
                                        <td>@FmtAuditDate(GetFechaCreacion(selectedProduct))</td>
                                        <td>@(string.IsNullOrWhiteSpace(GetUsuarioCreacion(selectedProduct)) ? "-" : GetUsuarioCreacion(selectedProduct))</td>
                                    </tr>
                                    <tr>
                                        <td>Última edición</td>
                                        <td>@FmtAuditDate(GetFechaModificacion(selectedProduct))</td>
                                        <td>@(string.IsNullOrWhiteSpace(GetUsuarioModificacion(selectedProduct)) ? "-" : GetUsuarioModificacion(selectedProduct))</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (activeDetailTab == "otros")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">SKU</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.SkuNumber" placeholder="SKU" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Part No.</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.PartNumber" placeholder="Part Number" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Modelo</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Model" placeholder="Modelo" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Código de barras</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.Codebar" placeholder="EAN / UPC" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Estado producto</label>
                                    <input class="form-control form-control-sm" type="text" @bind="selectedProduct.StatusProducts" placeholder="Ej. Disponible" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2 form-check">
                                    <input class="form-check-input" type="checkbox" @bind="selectedProduct.ManejaVencimiento" id="venDetalle" />
                                    <label class="form-check-label" for="venDetalle">Maneja vencimiento</label>
                                </div>
                                <div class="mb-2 form-check">
                                    <input class="form-check-input" type="checkbox" @bind="selectedProduct.ManejaSeriales" id="serDetalle" />
                                    <label class="form-check-label" for="serDetalle">Maneja seriales</label>
                                </div>
                                <div class="mb-2 form-check">
                                    <input class="form-check-input" type="checkbox" @bind="selectedProduct.ManejaLotes" id="loteDetalle" />
                                    <label class="form-check-label" for="loteDetalle">Maneja lotes</label>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Fecha vencimiento</label>
                                    <input class="form-control form-control-sm" type="date" @bind="selectedProduct.FechaVencimiento" @bind:format="yyyy-MM-dd" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Descripción</label>
                                    <textarea class="form-control form-control-sm" rows="3" @bind="selectedProduct.Description" placeholder="Descripción"></textarea>
                                </div>
                            </div>
                        </div>
                    }
                    </fieldset>

                    @if (activeDetailTab == "etiqueta")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="border p-3 rounded bg-white" style="max-width:320px;">
                                    <div class="fw-bold fs-5 text-truncate">@selectedProduct.Product_Name</div>
                                    <div class="text-muted small">@selectedProduct.Product_Type · @selectedProduct.Unidad</div>
                                    <div class="my-2 py-2 border rounded text-center font-monospace fs-4">@(string.IsNullOrWhiteSpace(selectedProduct.Codebar) ? (string.IsNullOrWhiteSpace(selectedProduct.Product_Code) ? "SIN CODIGO" : selectedProduct.Product_Code) : selectedProduct.Codebar)</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="font-monospace">@(string.IsNullOrWhiteSpace(selectedProduct.Codebar) ? selectedProduct.Product_Code : selectedProduct.Codebar)</span>
                                        <strong class="fs-4">@selectedProduct.Price.ToString("C")</strong>
                                    </div>
                                    <div class="small text-muted mt-1">ID @selectedProduct.Product_id</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Vista previa ZPL</label>
                                    <div class="border rounded p-2 bg-light font-monospace small text-break">^XA^PW406^LL406^FO10,10^A0N,28,28^FD@(selectedProduct.Product_Name)^FS^FO10,40^BCN,50,N,N,N^FD@(string.IsNullOrWhiteSpace(selectedProduct.Codebar) ? selectedProduct.Product_Code : selectedProduct.Codebar)^FS^XZ</div>
                                </div>
                                <button class="btn btn-primary" type="button" @onclick="() => OpenLabelPrint(selectedProduct)"><Icon Name="IconName.Printer" /> Imprimir etiqueta</button>
                                <div class="form-text mt-2">Los datos vienen de Detalle. Edita Código de barras y Precio en <strong>Detalle</strong> con <strong>Editar â†’ Guardar</strong>. Más formatos e impresoras en el módulo <strong>Etiquetas</strong>.</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<Modal @ref="createModal" Title="@(isEdit ? "Editar producto" : "Nuevo producto")">
    <BodyTemplate>
        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-secondary" @onclick="CloseModal" disabled="@isSaving"><Icon Name="IconName.XCircle" /> Cancelar</button>
            <button class="btn btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                <Icon Name="IconName.FloppyFill" />
                @(isSaving ? "Guardando..." : "Guardar en base de datos")
            </button>
        </div>
        <div class="row g-3">
            @if (isEdit)
            {
                <div class="col-12">
                    <label class="form-label text-muted">Product ID (auto)</label>
                    <input class="form-control" type="text" value="@editingId" disabled />
                </div>
            }
            <div class="col-12">
                <label class="form-label">Product ID <span class="text-danger">*</span></label>
                <input class="form-control" type="text" @bind="editProduct.Product_Code" placeholder="Ej. PROD-001" />
                @if (!isEdit)
                {
                    <div class="form-text">Se guardará tal cual en la base de datos. Si es numérico, también se usa como Product ID.</div>
                }
            </div>

            <div class="col-12">
                <label class="form-label">Nombre del producto <span class="text-danger">*</span></label>
                <input class="form-control" @bind="editProduct.Product_Name" placeholder="Nombre del producto" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Categoría <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select class="form-select" @bind:get="editProduct.Product_Type" @bind:set="(v => editProduct.Product_Type = v ?? string.Empty)" @bind:event="onchange">
                        <option value="">Seleccione una categoría...</option>
                        @foreach (var c in categorias.Where(cat => cat.IsActive).OrderBy(cat => cat.Name))
                        {
                            <option value="@c.Name">@c.Name</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(editProduct.Product_Type) && !categorias.Any(cat => cat.Name == editProduct.Product_Type))
                        {
                            <option value="@editProduct.Product_Type">@editProduct.Product_Type</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-secondary" @onclick="OpenCategoryManager" title="Gestionar categorías"><Icon Name="IconName.Gear" /></button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Unidad <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select class="form-select" @bind:get="editProduct.Unidad" @bind:set="(v => editProduct.Unidad = v ?? string.Empty)" @bind:event="onchange">
                        <option value="">Seleccione una unidad...</option>
                        @foreach (var u in unidades.Where(unit => unit.IsActive).OrderBy(unit => unit.Name))
                        {
                            <option value="@u.Name">@u.Name</option>
                        }
                        @if (!string.IsNullOrWhiteSpace(editProduct.Unidad) && !unidades.Any(unit => unit.Name == editProduct.Unidad))
                        {
                            <option value="@editProduct.Unidad">@editProduct.Unidad</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-secondary" @onclick="OpenUnitManager" title="Gestionar unidades"><Icon Name="IconName.Gear" /></button>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Precio de venta <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">RD$</span>
                    <input class="form-control" type="text" inputmode="decimal" placeholder="412,00" @bind:get="FormatModalPrice(editProduct.Price)" @bind:set="OnModalPriceChanged" />
                </div>
            </div>
        </div>

        <div class="mt-4">
            <label class="form-label"><strong>Fotos del producto (máx. 3)</strong></label>
            <small class="text-muted d-block">Imágenes seleccionadas: <strong>@modalImages.Count(f => f is not null)/3</strong></small>
            <p class="text-muted small">Haz clic en un cuadro vacío para elegir o cambiar la foto. Usa el botón X para eliminarla.</p>

            <div class="row g-2 mt-2 mb-3">
                @for (int i = 0; i < 3; i++)
                {
                    int currentIndex = i;
                    <div class="col-md-4">
                        <div class="image-preview-box clickable-box @(string.IsNullOrEmpty(imagePreviews[i]) ? "is-empty" : "")" @onclick="() => ClickImageBox(currentIndex)">
                            @if (!string.IsNullOrEmpty(imagePreviews[i]))
                            {
                                <div class="image-preview-area">
                                    <img src="@imagePreviews[i]" alt="Preview @(i+1)" class="img-preview" />
                                    <button type="button" class="btn-photo-action" @onclick:stopPropagation="true" @onclick="() => PickModalPhoto(currentIndex)" title="Cambiar foto"><Icon Name="IconName.HandIndexThumb" /></button>
                                    <button type="button" class="btn-remove-image" @onclick:stopPropagation="true" @onclick="() => RemoveImage(i)" title="Eliminar imagen"><Icon Name="IconName.XLg" /></button>
                                </div>
                                <div class="image-info">
                                    <small class="text-success fw-semibold"><Icon Name="IconName.CheckCircleFill" /> Imagen @(i + 1)</small>
                                    @if (!string.IsNullOrEmpty(imageNames[i]))
                                    {
                                        <div class="text-truncate" title="@imageNames[i]"><small>@imageNames[i]</small></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="image-placeholder">
                                    <div class="photo-placeholder-icon"><Icon Name="IconName.CameraFill" /></div>
                                    <div class="placeholder-text fw-semibold">Imagen @(i + 1)</div>
                                    <div class="placeholder-hint">Haz clic para seleccionar</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <InputFile id="modalPhotoInput" @ref="fileInput" OnChange="OnFileSelected" accept="image/*" hidden />
        </div>

    </BodyTemplate>
</Modal>

<Modal @ref="photoModal" Title="Foto ampliada" Size="ModalSize.ExtraLarge" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (!string.IsNullOrWhiteSpace(maximizedImage))
        {
            var photoIndices = GetPhotoIndices();
            <div style="min-height: calc(80vh + 2rem);">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    @if (photoIndices.Count > 1)
                    {
                        <button class="btn btn-outline-secondary flex-shrink-0" type="button" @onclick="PrevPhoto" title="Foto anterior"><Icon Name="IconName.ChevronLeft" /></button>
                    }
                    <img src="@maximizedImage" alt="Foto ampliada" style="width:100%; max-width:1200px; height:80vh; object-fit:contain; background:#f8f9fa; border:1px solid #dee2e6; border-radius:8px; padding:4px;" />
                    @if (photoIndices.Count > 1)
                    {
                        <button class="btn btn-outline-secondary flex-shrink-0" type="button" @onclick="NextPhoto" title="Foto siguiente"><Icon Name="IconName.ChevronRight" /></button>
                    }
                </div>
                <div class="text-center text-muted small mt-2" style="min-height:1.25rem;">@(photoIndices.Count > 1 ? $"{photoIndices.IndexOf(maximizedIndex) + 1} / {photoIndices.Count}" : "\u00A0")</div>
