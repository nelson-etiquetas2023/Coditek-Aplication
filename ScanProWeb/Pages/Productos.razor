<Modal @ref="reportModal" Title="Reporte de productos" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.Box" /> Total productos</div><div class="fs-3 fw-bold">@ReportTotalProducts</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.LayersFill" /> Unidades en stock</div><div class="fs-3 fw-bold">@ReportTotalStock.ToString("N0")</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.CashCoin" /> Valor costo</div><div class="fs-4 fw-bold">@ReportTotalCostValue.ToString("C")</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.CartFill" /> Valor venta</div><div class="fs-4 fw-bold">@ReportTotalPriceValue.ToString("C")</div></div></div>
        </div>
        <h6 class="fw-semibold"><Icon Name="IconName.Tags" /> Resumen por categoría</h6>
        <table class="table table-sm table-striped">
            <thead><tr><th>Categoría</th><th>Productos</th><th>Unidades</th><th class="text-end">Valor costo</th></tr></thead>
            <tbody>
                @foreach (var r in ReportByCategory)
                {
                    <tr><td>@r.Categoria</td><td>@r.Count</td><td>@r.StockSum.ToString("N0")</td><td class="text-end">@r.Value.ToString("C")</td></tr>
                }
            </tbody>
        </table>
        <h6 class="fw-semibold mt-3"><Icon Name="IconName.ExclamationTriangleFill" /> Stock bajo mínimo (@ReportLowStock.Count())</h6>
        @if (ReportLowStock.Count == 0)
        {
            <p class="text-muted small">Sin productos bajo mínimo.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Producto</th><th>Marca</th><th>Stock</th><th>Mínimo</th></tr></thead>
                <tbody>
                    @foreach (var p in ReportLowStock)
                    {
                        <tr><td>@p.Product_Name</td><td>@p.Marca</td><td>@p.Stock.ToString("N0")</td><td>@p.Stock_Mix.ToString("N0")</td></tr>
                    }
                </tbody>
            </table>
        }
        <div class="form-text mt-2">Reporte según filtro actual: <strong>@productsFiltered.Count() de @(products?.Count ?? 0)</strong> productos.</div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseProductReport"><Icon Name="IconName.XCircle" /> Cerrar</button>
        <button class="btn btn-outline-info" @onclick="ExportToExcel"><Icon Name="IconName.FileEarmarkExcel" /> Exportar Excel</button>
        <button class="btn btn-primary" @onclick="PrintProductReport"><Icon Name="IconName.Printer" /> Imprimir</button>
    </FooterTemplate>
</Modal>

