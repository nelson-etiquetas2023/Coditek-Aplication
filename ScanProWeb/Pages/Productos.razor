    private async Task OnDetailPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (detailNextImageSlot < 0 || detailNextImageSlot >= 3) return;
        try
        {
            var buffer = new byte[file.Size];
            using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
            {
                var totalRead = 0;
                var remaining = (int)file.Size;
                while (remaining > 0)
                {
                    var read = await stream.ReadAsync(buffer, totalRead, remaining);
                    if (read == 0) break;
                    totalRead += read;
                    remaining -= read;
                }
            }
            var base64 = Convert.ToBase64String(buffer);
            var contentType = file.ContentType ?? DetectContentType(file.Name);
            detailImagePreviews[detailNextImageSlot] = $"data:{contentType};base64,{base64}";
            detailImages[detailNextImageSlot] = (file.Name, contentType, buffer);
            detailImageRemoved[detailNextImageSlot] = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastSvc.Notify(new(ToastType.Danger, $"Error al cargar la foto: {ex.Message}"));
        }
    }

    private void RemoveDetailImage(int index)
    {
        if (index < 0 || index >= 3) return;
        detailImagePreviews[index] = string.Empty;
        detailImages[index] = null;
        if (detailExistingImageIds[index].HasValue) detailImageRemoved[index] = true;
        StateHasChanged();
    }

