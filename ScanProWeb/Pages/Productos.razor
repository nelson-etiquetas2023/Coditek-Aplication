        StateHasChanged();
        await LoadDetailImagesAsync();
    }

    private async Task LoadDetailImagesAsync()
    {
        var forId = selectedProduct?.Product_id ?? 0;
        detailImagePreviews = new string[3];
        if (selectedProduct?.Images is null || forId <= 0) return;

        var productImages = selectedProduct.Images
            .Where(i => i.ProductId == selectedProduct.Product_id || i.ProductId == 0)
            .OrderBy(i => i.ImageIndex)
            .ToList();

        foreach (var image in productImages)
        {
            if (image.ImageIndex < 0 || image.ImageIndex >= 3) continue;
            if (image.Id <= 0) continue;
            try
            {
                var bytes = await Api.GetProductImageBytesAsync(image.Id);
                if (selectedProduct?.Product_id != forId) return;
                if (bytes is not null && bytes.Length > 0)
                {
                    var base64 = Convert.ToBase64String(bytes);
                    detailImagePreviews[image.ImageIndex] = $"data:{image.ContentType ?? "image/jpeg"};base64,{base64}";
                }
            }
            catch { }
        }
        if (selectedProduct?.Product_id == forId)
            StateHasChanged();
    }

