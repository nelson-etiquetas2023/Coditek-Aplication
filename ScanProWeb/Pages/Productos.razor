    private async Task Delete(ApiProductService.Product p)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar producto {p.Product_Name}?");
        if (!confirmed) return;

        var ok = await Api.DeleteProductAsync(p.Product_id);
        if (ok)
        {
            ToastSvc.Notify(new(ToastType.Success, "Producto eliminado."));
            await LoadProducts();
            Buscar();
        }
        else
        {
            ToastSvc.Notify(new(ToastType.Danger, "No se pudo eliminar el producto."));
        }
    }

    private async Task ExportToExcel()
    {
        var list = productsFiltered?.ToList() ?? new();
        if (list.Count == 0)
        {
            ToastSvc.Notify(new(ToastType.Warning, "No hay productos para exportar."));
            return;
        }

        try
        {
            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Productos");

            worksheet.Cell(1, 1).Value = "Product ID";
            worksheet.Cell(1, 2).Value = "Product Code";
            worksheet.Cell(1, 3).Value = "Nombre";
            worksheet.Cell(1, 4).Value = "Categoría";
            worksheet.Cell(1, 5).Value = "Unidad";
            worksheet.Cell(1, 6).Value = "Marca";
            worksheet.Cell(1, 7).Value = "Código de barras";
            worksheet.Cell(1, 8).Value = "Precio";
            worksheet.Cell(1, 9).Value = "Costo";
            worksheet.Cell(1, 10).Value = "Stock";
            worksheet.Cell(1, 11).Value = "Stock mínimo";
            worksheet.Cell(1, 12).Value = "Stock máximo";
            worksheet.Cell(1, 13).Value = "Activo";
            worksheet.Range(1, 1, 1, 13).Style.Font.Bold = true;

            var row = 2;
            foreach (var p in list)
            {
                worksheet.Cell(row, 1).Value = p.Product_id;
                worksheet.Cell(row, 2).Value = p.Product_Code;
                worksheet.Cell(row, 3).Value = p.Product_Name;
                worksheet.Cell(row, 4).Value = p.Product_Type;
                worksheet.Cell(row, 5).Value = p.Unidad;
                worksheet.Cell(row, 6).Value = p.Marca;
                worksheet.Cell(row, 7).Value = p.Codebar;
                worksheet.Cell(row, 8).Value = p.Price;
                worksheet.Cell(row, 9).Value = p.Costo;
                worksheet.Cell(row, 10).Value = p.Stock;
                worksheet.Cell(row, 11).Value = p.Stock_Mix;
                worksheet.Cell(row, 12).Value = p.Stock_Max;
                worksheet.Cell(row, 13).Value = p.IsActive ? "Sí" : "No";
                row++;
            }

            worksheet.Columns().AdjustToContents();
            worksheet.SheetView.FreezeRows(1);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var content = stream.ToArray();

            await JS.InvokeVoidAsync("downloadFile", $"Productos_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", Convert.ToBase64String(content));
            ToastSvc.Notify(new(ToastType.Success, $"Exportados {list.Count} productos a Excel."));
        }
        catch (Exception ex)
        {
            ToastSvc.Notify(new(ToastType.Danger, $"Error al exportar: {ex.Message}"));
        }
    }

