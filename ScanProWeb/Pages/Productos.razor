<Modal @ref="reportModal" Title="Reporte de productos" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.Box" /> Total productos</div><div class="fs-3 fw-bold">@ReportTotalProducts</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.LayersFill" /> Unidades en stock</div><div class="fs-3 fw-bold">@ReportTotalStock.ToString("N0")</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.CashCoin" /> Valor costo</div><div class="fs-4 fw-bold">@ReportTotalCostValue.ToString("C")</div></div></div>
            <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="small text-muted"><Icon Name="IconName.CartFill" /> Valor venta</div><div class="fs-4 fw-bold">@ReportTotalPriceValue.ToString("C")</div></div></div>
        </div>
        <h6 class="fw-semibold"><Icon Name="IconName.Tags" /> Resumen por categoría</h6>
        <table class="table table-sm table-striped">
            <thead><tr><th>Categoría</th><th>Productos</th><th>Unidades</th><th class="text-end">Valor costo</th></tr></thead>
            <tbody>
                @foreach (var r in ReportByCategory)
                {
                    <tr><td>@r.Categoria</td><td>@r.Count</td><td>@r.StockSum.ToString("N0")</td><td class="text-end">@r.Value.ToString("C")</td></tr>
                }
            </tbody>
        </table>
        <h6 class="fw-semibold mt-3"><Icon Name="IconName.ExclamationTriangleFill" /> Stock bajo mínimo (@ReportLowStock.Count())</h6>
        @if (ReportLowStock.Count == 0)
        {
            <p class="text-muted small">Sin productos bajo mínimo.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Producto</th><th>Marca</th><th>Stock</th><th>Mínimo</th></tr></thead>
                <tbody>
                    @foreach (var p in ReportLowStock)
                    {
                        <tr><td>@p.Product_Name</td><td>@p.Marca</td><td>@p.Stock.ToString("N0")</td><td>@p.Stock_Mix.ToString("N0")</td></tr>
                    }
                </tbody>
            </table>
        }
        <div class="form-text mt-2">Reporte según filtro actual: <strong>@productsFiltered.Count() de @(products?.Count ?? 0)</strong> productos.</div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseProductReport"><Icon Name="IconName.XCircle" /> Cerrar</button>
        <button class="btn btn-outline-info" @onclick="ExportToExcel"><Icon Name="IconName.FileEarmarkExcel" /> Exportar Excel</button>
        <button class="btn btn-primary" @onclick="PrintProductReport"><Icon Name="IconName.Printer" /> Imprimir</button>
    </FooterTemplate>
</Modal>

<CategoryUnitManager @ref="categoryUnitManager" OnChanged="ReloadCategoryUnitLists" OnCategorySelected="OnCategorySelectedFromManager" OnUnitSelected="OnUnitSelectedFromManager" />

@code {
    private List<ApiProductService.Product>? products;
    private IEnumerable<ApiProductService.Product> productsFiltered = new List<ApiProductService.Product>();
    private List<ApiConfigService.CategoryDto> categorias = new();
    private List<ApiConfigService.ProductUnitDto> unidades = new();
    private Modal? createModal;
    private CategoryUnitManager categoryUnitManager = default!;
    private ApiProductService.Product editProduct = new();
    private ApiProductService.Product? selectedProduct;
    private bool isEdit;
    private bool isSaving;
    private int editingId;
    private string searchText = "";
    private string filtroTipo = "todos";
    private string activeDetailTab = "detalle";
    private bool IsFilterActive => !string.IsNullOrWhiteSpace(searchText);
    private string productViewMode = "grid";
    private Modal? labelModal = null;
    private ApiProductService.Product? labelProduct = null;
    private Modal? reportModal = null;
    private int ReportTotalProducts => productsFiltered?.Count() ?? 0;
    private double ReportTotalStock => productsFiltered?.Sum(p => p.Stock) ?? 0;
    private decimal ReportTotalCostValue => productsFiltered?.Sum(p => (decimal)p.Stock * p.Costo) ?? 0;
    private double ReportTotalPriceValue => productsFiltered?.Sum(p => p.Stock * p.Price) ?? 0;
    private List<(string Categoria, int Count, double StockSum, decimal Value)> ReportByCategory =>
        (productsFiltered ?? new List<ApiProductService.Product>())
            .GroupBy(p => string.IsNullOrWhiteSpace(p.Product_Type) ? "(Sin categoría)" : p.Product_Type.Trim())
            .OrderBy(g => g.Key)
            .Select(g => (Categoria: g.Key, Count: g.Count(), StockSum: g.Sum(x => x.Stock), Value: g.Sum(x => (decimal)x.Stock * x.Costo)))
            .ToList();
    private List<ApiProductService.Product> ReportLowStock =>
        (productsFiltered ?? new List<ApiProductService.Product>())
            .Where(p => p.Stock_Mix > 0 && p.Stock <= p.Stock_Mix)
            .OrderBy(p => p.Product_Name)
            .ToList();

    // Detalle en modo edición: Editar arriba -> Guardar/Cancelar -> volver a Editar
    private bool isDetailEditing = false;
    private ApiProductService.Product? detailBackup;

    // Fotos detalle: modal de ampliación + edición inline al editar
    private Modal? photoModal = null;
    private string? maximizedImage = null;
    private int maximizedIndex = -1;
    private int detailNextImageSlot = 0;
    private InputFile detailFileInput = default!;

    // Fotos: sin URL, como en ScanPro (archivo + vista previa en el cuadro)
    private InputFile fileInput = default!;
    private (string FileName, string ContentType, byte[] Data)?[] modalImages = new (string, string, byte[])?[3];
    private int?[] modalExistingImageIds = new int?[3];
    private bool[] modalImageRemoved = new bool[3];
    private string[] imagePreviews = new string[3];
    private string[] imageNames = new string[3];
    private int nextImageSlot = 0;
    private (string FileName, string ContentType, byte[] Data)?[] detailImages = new (string, string, byte[])?[3];
    private int?[] detailExistingImageIds = new int?[3];
    private bool[] detailImageRemoved = new bool[3];
    private string[] detailImagePreviews = new string[3];

    protected override async Task OnInitializedAsync()
    {
        categorias = await ConfigApi.GetCategoriesAsync();
        unidades = await ConfigApi.GetProductUnitsAsync();
        await LoadProducts();
    }

    private async Task OpenCategoryManager() => await categoryUnitManager.ShowCategoriesAsync();
    private async Task OpenUnitManager() => await categoryUnitManager.ShowUnitsAsync();
    private async Task ReloadCategoryUnitLists()
    {
        categorias = await ConfigApi.GetCategoriesAsync();
        unidades = await ConfigApi.GetProductUnitsAsync();
        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        products = await Api.GetProductsAsync();
        productsFiltered = (products ?? new()).OrderByDescending(p => p.Product_id).ToList();

        if (productsFiltered.Any())
        {
            selectedProduct = productsFiltered.First();
            isDetailEditing = false;
            detailBackup = null;
            await LoadDetailImagesAsync();
        }
        else
        {
            selectedProduct = null;
            isDetailEditing = false;
            detailBackup = null;
            detailImagePreviews = new string[3];
        }
    }

    private void OnSearchTextChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        Buscar();
    }

    private void OnFiltroTipoChanged(string value)
    {
        filtroTipo = value;
        if (value == "todos")
        {
            searchText = string.Empty;
        }
        Buscar();
    }

    private void OnCategorySelectedFromManager(string name)
    {
        editProduct.Product_Type = name;
        StateHasChanged();
    }

    private void OnUnitSelectedFromManager(string name)
    {
        editProduct.Unidad = name;
        StateHasChanged();
    }

    private void Buscar()
    {
        if (products is null)
        {
            return;
        }

        var filtro = searchText?.Trim() ?? string.Empty;
        var q = products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtro))
        {
            q = filtroTipo switch
            {
                "categoria" => q.Where(p => (p.Product_Type ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                "unidad" => q.Where(p => (p.Unidad ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                "marca" => q.Where(p => (p.Marca ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase)),
                _ => q.Where(p =>
                    p.Product_id.ToString().Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Code ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Name ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Product_Type ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Unidad ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Marca ?? string.Empty).Contains(filtro, StringComparison.OrdinalIgnoreCase))
            };
        }

        productsFiltered = q.OrderByDescending(p => p.Product_id).ToList();

        if (productsFiltered.Any())
        {
            // Si el seleccionado actual sigue en el filtro, mantenerlo; si no, tomar el primero.
            // Esto refresca los datos del tabpage (Detalle + Otros + fotos) al cambiar el filtro.
            if (selectedProduct is null || !productsFiltered.Any(p => p.Product_id == selectedProduct.Product_id))
            {
                selectedProduct = productsFiltered.First();
                isDetailEditing = false;
                detailBackup = null;
                _ = LoadDetailImagesAsync();
            }
        }
        else
        {
            selectedProduct = null;
            isDetailEditing = false;
            detailBackup = null;
            detailImagePreviews = new string[3];
        }
    }

    private string ActiveClass(string tab) => activeDetailTab == tab ? "active" : string.Empty;

    private string AriaSelected(string tab) => activeDetailTab == tab ? "true" : "false";

    private async Task SelectProduct(ApiProductService.Product product)
    {
        // Al seleccionar un producto del grid, refrescar los datos en las páginas del tabpage (Detalle y Otros)
        isDetailEditing = false;
        detailBackup = null;
        selectedProduct = product;
        StateHasChanged();
        await LoadDetailImagesAsync();
    }

    private async Task LoadDetailImagesAsync()
    {
        var forId = selectedProduct?.Product_id ?? 0;
        detailImagePreviews = new string[3];
        if (selectedProduct?.Images is null || forId <= 0) return;

        var productImages = selectedProduct.Images
            .Where(i => i.ProductId == selectedProduct.Product_id || i.ProductId == 0)
            .OrderBy(i => i.ImageIndex)
            .ToList();

        foreach (var image in productImages)
        {
            if (image.ImageIndex < 0 || image.ImageIndex >= 3) continue;
            if (image.Id <= 0) continue;
            try
            {
                var bytes = await Api.GetProductImageBytesAsync(image.Id);
                if (selectedProduct?.Product_id != forId) return;
                if (bytes is not null && bytes.Length > 0)
                {
                    var base64 = Convert.ToBase64String(bytes);
                    detailImagePreviews[image.ImageIndex] = $"data:{image.ContentType ?? "image/jpeg"};base64,{base64}";
                }
            }
            catch { }
        }
        if (selectedProduct?.Product_id == forId)
            StateHasChanged();
    }

    private async Task ClickImageBox(int index)
    {
        // Clic en cuadro ocupado -> eliminar; vacío -> abrir explorador de archivos (InputFile)
        if (!string.IsNullOrEmpty(imagePreviews[index]))
        {
            RemoveImage(index);
        }
        else
        {
            nextImageSlot = index;
            await OpenFileDialog();
        }
    }

    private async Task OpenFileDialog()
    {
        try
        {
            if (fileInput != null)
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('modalPhotoInput')?.click()");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null && nextImageSlot >= 0 && nextImageSlot < 3)
        {
            try
            {
                var buffer = new byte[file.Size];
                using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
                {
                    var totalRead = 0;
                    var remaining = (int)file.Size;
                    while (remaining > 0)
                    {
                        var read = await stream.ReadAsync(buffer, totalRead, remaining);
                        if (read == 0)
                            break;
                        totalRead += read;
                        remaining -= read;
                    }
                }

                var base64 = Convert.ToBase64String(buffer);
                var contentType = file.ContentType ?? DetectContentType(file.Name);
                imagePreviews[nextImageSlot] = $"data:{contentType};base64,{base64}";
                imageNames[nextImageSlot] = file.Name;
                modalImages[nextImageSlot] = (file.Name, contentType, buffer);
                if (nextImageSlot >= 0 && nextImageSlot < modalImageRemoved.Length) modalImageRemoved[nextImageSlot] = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando archivo: {ex.Message}");
            }
        }
    }

    private void RemoveImage(int index)
    {
        if (index < 0 || index >= 3)
            return;

        imagePreviews[index] = string.Empty;
        imageNames[index] = string.Empty;
        modalImages[index] = null;
        if (index < modalExistingImageIds.Length && modalExistingImageIds[index].HasValue) modalImageRemoved[index] = true;
        StateHasChanged();
    }

    private string DetectContentType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            _ => "image/jpeg"
        };
    }

    private async Task OpenNew()
    {
        isEdit = false;
        isSaving = false;
        editingId = 0;
        modalImages = new (string, string, byte[])?[3];
        modalExistingImageIds = new int?[3];
        modalImageRemoved = new bool[3];
        imagePreviews = new string[3];
        imageNames = new string[3];
        nextImageSlot = 0;
        editProduct = new ApiProductService.Product
        {
            Product_id = 0,
            Product_Code = "",
            Product_Name = "",
            Product_Type = "",
            Unidad = "",
            Price = 0,
            Codebar = "",
            Costo = 0,
            Stock = 0,
            Stock_Mix = 0,
            Stock_Max = 0,
            FechaVencimiento = null,
            ManejaVencimiento = false,
            ManejaSeriales = false,
            ManejaLotes = false,
            Description = "",
            SkuNumber = "",
            PartNumber = "",
            Model = "",
            Marca = "",
            StatusProducts = "",
            IsActive = true,
            Images = new()
        };

        if (createModal is not null) await createModal.ShowAsync();
    }

    // (edición por modal eliminada: flujo activo es edición inline en detalle)

    private async Task CloseModal()
    {
        if (createModal is not null) await createModal.HideAsync();
    }

    private async Task SaveProduct()
    {
        if (isSaving) return;

        // Product_id es IDENTITY en BD: al crear siempre 0 (evita SQL 544)
        if (isEdit)
        {
            editProduct.Product_id = editingId;
        }
        else
        {
            editProduct.Product_id = 0;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Code))
        {
            ToastSvc.Notify(new(ToastType.Danger, "El código del producto es obligatorio para crear un nuevo producto."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Name))
        {
            ToastSvc.Notify(new(ToastType.Danger, "El nombre del producto es obligatorio."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Type))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La categoría es obligatoria."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Unidad))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La unidad es obligatoria."));
            return;
        }

        if (editProduct.Price <= 0)
        {
            ToastSvc.Notify(new(ToastType.Danger, "El precio debe ser mayor a cero."));
            return;
        }

        // Fotos: sin URL, archivos reales (multipart al crear / base64 al editar)
        editProduct.Images ??= new();
        isSaving = true;
        StateHasChanged();
        try
        {
            bool ok;
            string? errorDetail = null;
            ApiProductService.Product? created = null;
            var imageErrors = new List<string>();

            if (isEdit)
            {
                var res = await Api.UpdateProductWithDetailsAsync(editingId, editProduct);
                ok = res.Success;
                errorDetail = res.Error;

                if (ok)
                {
                    // Subir fotos nuevas: si el slot ya tenía imagen, actualizar; si no, agregar
                    var existingByIndex = editProduct.Images
                        .Where(i => i.Id > 0)
                        .GroupBy(i => i.ImageIndex)
                        .ToDictionary(g => g.Key, g => g.First());

                    for (int slot = 0; slot < 3; slot++)
                    {
                        var img = modalImages[slot];
                        if (img is null) continue;
                        try
                        {
                            var base64 = Convert.ToBase64String(img.Value.Data);
                            var existing = existingByIndex.TryGetValue(slot, out var ei) ? ei : null;
                            bool imgOk;
                            if (existing is not null)
                            {
                                imgOk = await Api.UpdateProductImageAsync(existing.Id, base64, img.Value.FileName, img.Value.ContentType);
                                if (!imgOk)
                                    imgOk = await Api.AddProductImageAsync(editingId, base64, img.Value.FileName, img.Value.ContentType, slot);
                            }
                            else
                            {
                                imgOk = await Api.AddProductImageAsync(editingId, base64, img.Value.FileName, img.Value.ContentType, slot);
                            }
                            if (!imgOk)
                            {
                                imageErrors.Add($"foto {slot + 1}");
                            }
                        }
                        catch (Exception ex)
                        {
                            imageErrors.Add($"foto {slot + 1} ({ex.Message})");
                        }
                    }
                }
            }
            else
            {
                // Crear con archivos multipart (ScanPro)
                var uploads = modalImages
                    .Select((img, idx) => img is null ? null : new ApiProductService.ProductImageUpload { FileName = img.Value.FileName, ContentType = img.Value.ContentType, Data = img.Value.Data, Slot = idx })
                    .Where(u => u is not null)
                    .Cast<ApiProductService.ProductImageUpload>()
                    .ToList();
                var res = await Api.CreateProductWithFilesAsync(editProduct, uploads);
                ok = res.Success;
                errorDetail = res.Error;
                created = res.CreatedProduct;
            }

            if (ok)
            {
                if (isEdit && imageErrors.Count > 0)
                    ToastSvc.Notify(new(ToastType.Warning, $"Producto guardado, pero no se pudo guardar: {string.Join(", ", imageErrors)}."));
                else
                    ToastSvc.Notify(new(ToastType.Success, isEdit ? "Producto actualizado en la base de datos." : "Producto guardado en la base de datos exitosamente."));
                modalImages = new (string, string, byte[])?[3];
                modalExistingImageIds = new int?[3];
                modalImageRemoved = new bool[3];
                imagePreviews = new string[3];
                imageNames = new string[3];
                nextImageSlot = 0;
                var targetId = isEdit ? editingId : (created?.Product_id ?? 0);
                await LoadProducts();
                if (targetId > 0)
                {
                    var refreshed = await Api.GetProductAsync(targetId);
                    if (refreshed is not null && products is not null)
                    {
                        var idx = products.FindIndex(p => p.Product_id == targetId);
                        if (idx >= 0) products[idx] = refreshed; else products.Add(refreshed);
                    }
                }
                Buscar();
                if (targetId > 0 && products is not null)
                {
                    selectedProduct = products.FirstOrDefault(p => p.Product_id == targetId);
                }
                if (selectedProduct is not null)
                {
                    await LoadDetailImagesAsync();
                }
                if (createModal is not null) await createModal.HideAsync();
            }
            else
            {
                var msg = string.IsNullOrWhiteSpace(errorDetail)
                    ? "No se pudo guardar el producto. Revisa que la API esté disponible (http://localhost:5220) y conectada a la base de datos."
                    : $"Error en base de datos / API: {errorDetail}";
                ToastSvc.Notify(new(ToastType.Danger, msg));
            }
        }
        catch (Exception ex)
        {
            ToastSvc.Notify(new(ToastType.Danger, $"Error inesperado al guardar: {ex.Message}"));
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void StartDetailEdit()
    {
        if (selectedProduct is null) return;
        detailBackup = CloneProduct(selectedProduct);
        detailImages = new (string, string, byte[])?[3];
        detailImageRemoved = new bool[3];
        detailExistingImageIds = new int?[3];
        if (selectedProduct.Images is not null)
        {
            foreach (var img in selectedProduct.Images.Where(i => i.Id > 0))
            {
                if (img.ImageIndex >= 0 && img.ImageIndex < 3 && detailExistingImageIds[img.ImageIndex] is null)
                    detailExistingImageIds[img.ImageIndex] = img.Id;
            }
        }
        isDetailEditing = true;
    }

    private void CancelDetailEdit()
    {
        if (selectedProduct is not null && detailBackup is not null)
        {
            CopyProduct(detailBackup, selectedProduct);
        }
        detailBackup = null;
        detailImages = new (string, string, byte[])?[3];
        detailImageRemoved = new bool[3];
        detailExistingImageIds = new int?[3];
        isDetailEditing = false;
        _ = LoadDetailImagesAsync();
    }

