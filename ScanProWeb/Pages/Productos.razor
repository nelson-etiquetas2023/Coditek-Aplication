    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && nextImageSlot >= 0 && nextImageSlot < 3)
        {
            try
            {
                var buffer = new byte[file.Size];
                using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
                {
                    var totalRead = 0;
                    var remaining = (int)file.Size;
                    while (remaining > 0)
                    {
                        var read = await stream.ReadAsync(buffer, totalRead, remaining);
                        if (read == 0) break;
                        totalRead += read;
                        remaining -= read;
                    }
                }
                var base64 = Convert.ToBase64String(buffer);
                var contentType = file.ContentType ?? DetectContentType(file.Name);
                imagePreviews[nextImageSlot] = $"data:{contentType};base64,{base64}";
                imageNames[nextImageSlot] = file.Name;
                modalImages[nextImageSlot] = (file.Name, contentType, buffer);
                if (nextImageSlot >= 0 && nextImageSlot < modalImageRemoved.Length) modalImageRemoved[nextImageSlot] = false;
                StateHasChanged();
            }
            catch (Exception ex) { Console.WriteLine($"Error cargando archivo: {ex.Message}"); }
        }
    }

    private void RemoveImage(int index)
    {
        if (index < 0 || index >= 3) return;
        imagePreviews[index] = string.Empty;
        imageNames[index] = string.Empty;
        modalImages[index] = null;
        if (index < modalExistingImageIds.Length && modalExistingImageIds[index].HasValue) modalImageRemoved[index] = true;
        StateHasChanged();
    }

    private string DetectContentType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            _ => "image/jpeg"
        };
    }

