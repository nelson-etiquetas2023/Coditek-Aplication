    private async Task SaveDetailChanges()
    {
        if (selectedProduct is null || isSaving) return;

        if (string.IsNullOrWhiteSpace(selectedProduct.Product_Code))
        {
            selectedProduct.Product_Code = selectedProduct.Product_id.ToString();
        }

        if (string.IsNullOrWhiteSpace(selectedProduct.Product_Name))
        {
            ToastSvc.Notify(new(ToastType.Danger, "El nombre del producto es obligatorio."));
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedProduct.Product_Type))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La categoría es obligatoria."));
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedProduct.Unidad))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La unidad es obligatoria."));
            return;
        }
        if (selectedProduct.Price <= 0)
        {
            ToastSvc.Notify(new(ToastType.Danger, "El precio debe ser mayor a cero."));
            return;
        }

        isSaving = true;
        StateHasChanged();
        try
        {
            var res = await Api.UpdateProductWithDetailsAsync(selectedProduct.Product_id, selectedProduct);
            if (res.Success)
            {
                // Subir fotos elegidas en detalle (al editar también puedo poner las fotos)
                var imageErrors = new List<string>();
                var existingByIndex = selectedProduct.Images
                    .Where(i => i.Id > 0)
                    .GroupBy(i => i.ImageIndex)
                    .ToDictionary(g => g.Key, g => g.First());
                for (int slot = 0; slot < 3; slot++)
                {
                    var img = detailImages[slot];
                    if (img is not null)
                    {
                        try
                        {
                            var base64 = Convert.ToBase64String(img.Value.Data);
                            var existing = existingByIndex.TryGetValue(slot, out var ei) ? ei : detailExistingImageIds.ElementAtOrDefault(slot).HasValue ? new ApiProductService.ProductImage { Id = detailExistingImageIds[slot]!.Value } : null;
                            bool imgOk;
                            if (existing is not null && existing.Id > 0)
                            {
                                imgOk = await Api.UpdateProductImageAsync(existing.Id, base64, img.Value.FileName, img.Value.ContentType);
                                if (!imgOk)
                                    imgOk = await Api.AddProductImageAsync(selectedProduct.Product_id, base64, img.Value.FileName, img.Value.ContentType, slot);
                            }
                            else
                            {
                                imgOk = await Api.AddProductImageAsync(selectedProduct.Product_id, base64, img.Value.FileName, img.Value.ContentType, slot);
                            }
                            if (!imgOk)
                                imageErrors.Add($"foto {slot + 1}");
                        }
                        catch (Exception ex)
                        {
                            imageErrors.Add($"foto {slot + 1} ({ex.Message})");
                        }
                    }
                    else if (slot < detailImageRemoved.Length && detailImageRemoved[slot] && slot < detailExistingImageIds.Length && detailExistingImageIds[slot].HasValue)
                    {
                        try
                        {
                            var delOk = await Api.DeleteProductImageAsync(detailExistingImageIds[slot]!.Value);
                            if (!delOk)
                                imageErrors.Add($"foto {slot + 1} (eliminar)");
                        }
                        catch (Exception ex)
                        {
                            imageErrors.Add($"foto {slot + 1} ({ex.Message})");
                        }
                    }
                }

                if (imageErrors.Count == 0)
                    ToastSvc.Notify(new(ToastType.Success, "Cambios guardados en la base de datos."));
                else
                    ToastSvc.Notify(new(ToastType.Warning, $"Producto guardado, pero no se pudo guardar: {string.Join(", ", imageErrors)}."));
                detailBackup = null;
                detailImages = new (string, string, byte[])?[3];
                detailImageRemoved = new bool[3];
                detailExistingImageIds = new int?[3];
                isDetailEditing = false;
                var keepId = selectedProduct.Product_id;
                await LoadProducts();
                var refreshed = await Api.GetProductAsync(keepId);
                if (refreshed is not null && products is not null)
                {
                    var idx = products.FindIndex(p => p.Product_id == keepId);
                    if (idx >= 0) products[idx] = refreshed; else products.Add(refreshed);
                }
                Buscar();
                selectedProduct = products?.FirstOrDefault(p => p.Product_id == keepId) ?? refreshed ?? selectedProduct;
                await LoadDetailImagesAsync();
            }
            else
            {
                var msg = string.IsNullOrWhiteSpace(res.Error)
                    ? "No se pudieron guardar los cambios. Revisa que la API esté disponible (http://localhost:5220)."
                    : $"Error en base de datos / API: {res.Error}";
                ToastSvc.Notify(new(ToastType.Danger, msg));
            }
        }
        catch (Exception ex)
        {
            ToastSvc.Notify(new(ToastType.Danger, $"Error inesperado al guardar: {ex.Message}"));
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

