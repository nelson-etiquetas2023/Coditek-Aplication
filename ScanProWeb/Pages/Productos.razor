    private async Task SaveProduct()
    {
        if (isSaving) return;

        // Product_id es IDENTITY en BD: al crear siempre 0 (evita SQL 544)
        if (isEdit)
        {
            editProduct.Product_id = editingId;
        }
        else
        {
            editProduct.Product_id = 0;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Code))
        {
            ToastSvc.Notify(new(ToastType.Danger, "El código del producto es obligatorio para crear un nuevo producto."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Name))
        {
            ToastSvc.Notify(new(ToastType.Danger, "El nombre del producto es obligatorio."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Product_Type))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La categoría es obligatoria."));
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.Unidad))
        {
            ToastSvc.Notify(new(ToastType.Danger, "La unidad es obligatoria."));
            return;
        }

        if (editProduct.Price <= 0)
        {
            ToastSvc.Notify(new(ToastType.Danger, "El precio debe ser mayor a cero."));
            return;
        }

        // Fotos: sin URL, archivos reales (multipart al crear / base64 al editar)
        editProduct.Images ??= new();
        isSaving = true;
        StateHasChanged();
        try
        {
            bool ok;
            string? errorDetail = null;
            ApiProductService.Product? created = null;

            if (isEdit)
            {
                var res = await Api.UpdateProductWithDetailsAsync(editingId, editProduct);
                ok = res.Success;
                errorDetail = res.Error;
            }
            else
            {
                var uploads = modalImages
                    .Select((img, idx) => img is null ? null : new ApiProductService.ProductImageUpload { FileName = img.Value.FileName, ContentType = img.Value.ContentType, Data = img.Value.Data, Slot = idx })
                    .Where(u => u is not null)
                    .Cast<ApiProductService.ProductImageUpload>()
                    .ToList();
                var res = await Api.CreateProductWithFilesAsync(editProduct, uploads);
                ok = res.Success;
                errorDetail = res.Error;
                created = res.CreatedProduct;
            }

            if (ok)
            {
                ToastSvc.Notify(new(ToastType.Success, isEdit ? "Producto actualizado en la base de datos." : "Producto guardado en la base de datos exitosamente."));
                modalImages = new (string, string, byte[])?[3];
                modalExistingImageIds = new int?[3];
                modalImageRemoved = new bool[3];
                imagePreviews = new string[3];
                imageNames = new string[3];
                nextImageSlot = 0;
                var targetId = isEdit ? editingId : (created?.Product_id ?? 0);
                await LoadProducts();
                if (targetId > 0)
                {
                    var refreshed = await Api.GetProductAsync(targetId);
                    if (refreshed is not null && products is not null)
                    {
                        var idx = products.FindIndex(p => p.Product_id == targetId);
                        if (idx >= 0) products[idx] = refreshed; else products.Add(refreshed);
                    }
                }
                Buscar();
                if (targetId > 0 && products is not null)
                {
                    selectedProduct = products.FirstOrDefault(p => p.Product_id == targetId);
                }
                if (selectedProduct is not null)
                {
                    await LoadDetailImagesAsync();
                }
                if (createModal is not null) await createModal.HideAsync();
            }
            else
            {
                var msg = string.IsNullOrWhiteSpace(errorDetail)
                    ? "No se pudo guardar el producto. Revisa que la API esté disponible (http://localhost:5220) y conectada a la base de datos."
                    : $"Error en base de datos / API: {errorDetail}";
                ToastSvc.Notify(new(ToastType.Danger, msg));
            }
        }
        catch (Exception ex)
        {
            ToastSvc.Notify(new(ToastType.Danger, $"Error inesperado al guardar: {ex.Message}"));
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

