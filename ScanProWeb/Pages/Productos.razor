    private async Task OpenPhotoViewerFor(string[] previews, int index)
    {
        if (previews is null || index < 0 || index >= previews.Length) return;
        if (string.IsNullOrWhiteSpace(previews[index])) return;
        activePhotoPreviews = previews;
        maximizedIndex = index;
        maximizedImage = previews[index];
        if (photoModal is not null) await photoModal.ShowAsync();
    }

    private async Task ClosePhotoViewer() { if (photoModal is not null) await photoModal.HideAsync(); }

    private List<int> GetPhotoIndices() => (activePhotoPreviews ?? Array.Empty<string>())
        .Select((img, idx) => new { img, idx })
        .Where(x => !string.IsNullOrWhiteSpace(x.img))
        .Select(x => x.idx)
        .ToList();

    private void ShowPhotoByIndex(int index)
    {
        if (activePhotoPreviews is null || index < 0 || index >= activePhotoPreviews.Length) return;
        if (string.IsNullOrWhiteSpace(activePhotoPreviews[index])) return;
        maximizedIndex = index;
        maximizedImage = activePhotoPreviews[index];
    }

    private void NextPhoto()
    {
        var indices = GetPhotoIndices();
        if (indices.Count == 0) return;
        var pos = indices.IndexOf(maximizedIndex);
        if (pos < 0) pos = 0;
        ShowPhotoByIndex(indices[(pos + 1) % indices.Count]);
    }

    private void PrevPhoto()
    {
        var indices = GetPhotoIndices();
        if (indices.Count == 0) return;
        var pos = indices.IndexOf(maximizedIndex);
        if (pos < 0) pos = 0;
        ShowPhotoByIndex(indices[(pos - 1 + indices.Count) % indices.Count]);
    }

