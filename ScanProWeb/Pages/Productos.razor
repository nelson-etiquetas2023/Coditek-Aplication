    }

    private static bool TryParseDecimalFlexible(string? value, out double result)
    {
        result = 0;
        if (string.IsNullOrWhiteSpace(value)) return true;
        var s = value.Trim().Replace(" ", "").Replace("RD$", "", StringComparison.OrdinalIgnoreCase);
        var hasComma = s.Contains(',');
        var hasDot = s.Contains('.');
        if (hasComma && hasDot)
        {
            if (s.LastIndexOf(',') > s.LastIndexOf('.'))
                s = s.Replace(".", "").Replace(',', '.');
            else
                s = s.Replace(",", "");
        }
        else if (hasComma)
        {
            s = s.Replace(',', '.');
        }
        return double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out result);
    }
