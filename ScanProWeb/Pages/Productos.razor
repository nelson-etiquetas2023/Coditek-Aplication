    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="ClosePhotoViewer"><Icon Name="IconName.XCircle" /> Cerrar</button>
    </FooterTemplate>
</Modal>

<Modal @ref="labelModal" Title="Etiqueta de código de barra" Size="ModalSize.Large">
    <BodyTemplate>
        @if (labelProduct is not null)
